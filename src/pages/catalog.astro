---
// src/pages/catalog.astro
// ─────────────────────────────────────────────
// wearit — /catalog page
// Sprint 2 · Step 3
//
// All 17 products loaded at build time from products.js
// Client-side filtering via vanilla JS (category + size)
// ProductCard.astro renders each product
// ─────────────────────────────────────────────

import Layout      from '../layouts/Layout.astro';
import ProductCard from '../components/catalog/ProductCard.astro';
import { allProducts } from '../data/products.js';

const totalCount = allProducts.length;

// Precompute unique standard sizes for filter chips
const standardSizes = ['S', 'M', 'L', 'XL'];

// Category tabs config
const categoryTabs = [
  { id: 'all',         label: 'All'         },
  { id: 'womens',      label: "Women's"     },
  { id: 'traditional', label: 'Traditional' },
  { id: 'kids',        label: 'Kids'        },
];
---

<Layout title="Costume Catalog — wearit, Hinjewadi Pune">

  <div class="catalog-page">

    <!-- ── Page Header ── -->
    <div class="catalog-header">
      <div class="catalog-header__inner">
        <a href="/" class="catalog-back">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          Back to home
        </a>
        <h1 class="catalog-header__title">Our Costume Collection</h1>
        <p class="catalog-header__sub">
          <span id="product-count">{totalCount}</span> costumes — washed, ironed &amp; festival-ready
        </p>
      </div>
    </div>

    <!-- ── Filter Bar ── -->
    <div class="filter-bar">
      <div class="filter-bar__inner">

        <!-- Category tabs -->
        <div class="filter-section">
          <p class="filter-label">Category</p>
          <div class="cat-tabs" role="tablist" aria-label="Filter by category">
            {categoryTabs.map((tab, i) => (
              <button
                class={`cat-tab${i === 0 ? ' cat-tab--active' : ''}`}
                data-category={tab.id}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                type="button"
              >
                {tab.label}
              </button>
            ))}
          </div>
        </div>

        <!-- Size filter — hidden when Kids tab active -->
        <div class="filter-section" id="size-filter">
          <p class="filter-label">Size</p>
          <div class="size-chips" role="group" aria-label="Filter by size">
            <button class="size-chip size-chip--active" data-size="all" type="button">All</button>
            {standardSizes.map(size => (
              <button class="size-chip" data-size={size} type="button">{size}</button>
            ))}
          </div>
        </div>

      </div>
    </div>

    <!-- ── Product Grid ── -->
    <div class="catalog-grid__wrap">
      <div class="catalog-grid__inner">

        <div class="catalog-grid" id="catalog-grid">
          {allProducts.map(product => (
            <div
              class="catalog-item"
              data-category={product.category}
              data-sizes={product.sizes.join(',')}
              data-sizetype={product.sizeType}
            >
              <ProductCard product={product} showCategory={true} />
            </div>
          ))}
        </div>

        <!-- Empty state -->
        <div class="empty-state" id="empty-state" style="display: none;">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
          </svg>
          <p class="empty-state__title">No costumes found</p>
          <p class="empty-state__sub">Try a different category or size filter</p>
          <button class="empty-state__reset" id="reset-filters" type="button">
            Reset filters
          </button>
        </div>

      </div>
    </div>

  </div>

</Layout>

<!-- ── Vanilla JS filtering ── -->
<script>
  // @ts-nocheck
  let activeCategory = 'all';
  let activeSize     = 'all';

  const allItems     = document.querySelectorAll('.catalog-item');
  const countEl      = document.getElementById('product-count');
  const emptyEl      = document.getElementById('empty-state');
  const sizeFilterEl = document.getElementById('size-filter');
  const catTabs      = document.querySelectorAll('.cat-tab');
  const sizeChips    = document.querySelectorAll('.size-chip');
  const resetBtn     = document.getElementById('reset-filters');

  function applyFilters() {
    let visible = 0;

    allItems.forEach(item => {
      const cat      = item.dataset.category;
      const sizes    = item.dataset.sizes.split(',');
      const sizeType = item.dataset.sizetype;

      const catMatch  = activeCategory === 'all' || cat === activeCategory;

      // Kids products bypass size filter — their sizes are age ranges
      const sizeMatch = activeSize === 'all'
        || sizeType === 'kids'
        || sizes.includes(activeSize);

      const show = catMatch && sizeMatch;
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    // Update count
    if (countEl) countEl.textContent = visible;

    // Show / hide empty state
    if (emptyEl) emptyEl.style.display = visible === 0 ? 'flex' : 'none';

    // Hide size filter when Kids tab active — kids use age ranges not S/M/L
    if (sizeFilterEl) {
      sizeFilterEl.style.display = activeCategory === 'kids' ? 'none' : 'block';
    }
  }

  // Category tab clicks
  catTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      catTabs.forEach(t => {
        t.classList.remove('cat-tab--active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('cat-tab--active');
      tab.setAttribute('aria-selected', 'true');
      activeCategory = tab.dataset.category;

      // Reset size when switching category
      activeSize = 'all';
      sizeChips.forEach(c => c.classList.remove('size-chip--active'));
      sizeChips[0].classList.add('size-chip--active');

      applyFilters();
    });
  });

  // Size chip clicks
  sizeChips.forEach(chip => {
    chip.addEventListener('click', () => {
      sizeChips.forEach(c => c.classList.remove('size-chip--active'));
      chip.classList.add('size-chip--active');
      activeSize = chip.dataset.size;
      applyFilters();
    });
  });

  // Reset filters button
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      activeCategory = 'all';
      activeSize     = 'all';

      catTabs.forEach((t, i) => {
        t.classList.toggle('cat-tab--active', i === 0);
        t.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
      });

      sizeChips.forEach((c, i) => c.classList.toggle('size-chip--active', i === 0));

      applyFilters();
    });
  }

  // Handle URL params on load — e.g. /catalog?category=womens
  const params = new URLSearchParams(window.location.search);
  const catParam = params.get('category') ?? params.get('tab');

  if (catParam) {
    const matchTab = document.querySelector(`.cat-tab[data-category="${catParam}"]`);
    if (matchTab) {
      catTabs.forEach(t => {
        t.classList.remove('cat-tab--active');
        t.setAttribute('aria-selected', 'false');
      });
      matchTab.classList.add('cat-tab--active');
      matchTab.setAttribute('aria-selected', 'true');
      activeCategory = catParam;
      applyFilters();
    }
  }
</script>

<style>
  /* ═══════════════════════════════════════════
     PAGE WRAPPER
  ═══════════════════════════════════════════ */
  .catalog-page {
    background: #FDF6EE;
    min-height: 100vh;
  }

  /* ═══════════════════════════════════════════
     PAGE HEADER
  ═══════════════════════════════════════════ */
  .catalog-header {
    background: #FDF6EE;
    border-bottom: 0.5px solid rgba(26, 26, 46, 0.08);
    padding: 1.5rem 0 1.25rem;
  }

  .catalog-header__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 768px) {
    .catalog-header__inner { padding-inline: 3rem; }
  }

  .catalog-back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: rgba(26, 26, 46, 0.45);
    text-decoration: none;
    margin-bottom: 0.875rem;
    transition: color 0.15s ease;
  }

  .catalog-back:hover { color: #E85D26; }

  .catalog-header__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    color: #1A1A2E;
    margin: 0 0 0.375rem;
  }

  .catalog-header__sub {
    font-size: 0.875rem;
    color: rgba(26, 26, 46, 0.45);
    margin: 0;
  }

  /* ═══════════════════════════════════════════
     FILTER BAR
  ═══════════════════════════════════════════ */
  .filter-bar {
    background: #fff;
    border-bottom: 0.5px solid rgba(26, 26, 46, 0.08);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .filter-bar__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding: 0.875rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .filter-bar__inner {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
      padding: 0.875rem 3rem;
    }
  }

  .filter-section { display: flex; align-items: center; gap: 0.75rem; }

  .filter-label {
    font-size: 0.6875rem;
    font-weight: 600;
    color: rgba(26, 26, 46, 0.4);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── Category tabs ── */
  .cat-tabs {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .cat-tabs::-webkit-scrollbar { display: none; }

  .cat-tab {
    padding: 0.4375rem 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(26, 26, 46, 0.45);
    background: transparent;
    border: 1px solid rgba(26, 26, 46, 0.12);
    border-radius: 9999px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
    min-height: 36px;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
    font-family: inherit;
  }

  .cat-tab:hover { color: #E85D26; border-color: rgba(232,93,38,0.3); }

  .cat-tab--active {
    background: #E85D26 !important;
    border-color: #E85D26 !important;
    color: #fff !important;
    font-weight: 600 !important;
  }

  /* ── Size chips ── */
  .size-chips {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }

  .size-chip {
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(26, 26, 46, 0.45);
    background: transparent;
    border: 1px solid rgba(26, 26, 46, 0.12);
    border-radius: 0.375rem;
    cursor: pointer;
    transition: all 0.15s ease;
    min-height: 36px;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
    font-family: inherit;
  }

  .size-chip:hover { color: #E85D26; border-color: rgba(232,93,38,0.3); }

  .size-chip--active {
    background: #1A1A2E !important;
    border-color: #1A1A2E !important;
    color: #fff !important;
    font-weight: 600 !important;
  }

  /* ═══════════════════════════════════════════
     PRODUCT GRID
  ═══════════════════════════════════════════ */
  .catalog-grid__wrap {
    padding: 1.5rem 0 3rem;
  }

  .catalog-grid__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 768px) {
    .catalog-grid__inner { padding-inline: 3rem; }
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.875rem;
  }

  @media (min-width: 640px) {
    .catalog-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  }

  @media (min-width: 768px) {
    .catalog-grid { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  }

  @media (min-width: 1024px) {
    .catalog-grid { grid-template-columns: repeat(4, 1fr); }
  }

  /* ═══════════════════════════════════════════
     EMPTY STATE
  ═══════════════════════════════════════════ */
  .empty-state {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 1rem;
    gap: 0.75rem;
    color: rgba(26, 26, 46, 0.35);
    text-align: center;
  }

  .empty-state__title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #1A1A2E;
    margin: 0;
  }

  .empty-state__sub {
    font-size: 0.875rem;
    margin: 0;
  }

  .empty-state__reset {
    margin-top: 0.5rem;
    background: #E85D26;
    color: #fff;
    border: none;
    border-radius: 0.5rem;
    padding: 0.625rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s ease;
  }

  .empty-state__reset:hover { background: #D04F1E; }
</style>