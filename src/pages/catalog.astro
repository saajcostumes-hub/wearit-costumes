---
// @ts-nocheck
// src/pages/catalog.astro — Sprint 4 update
// Phase 1: 5 women's categories + Kids coming soon
// ─────────────────────────────────────────────

import Layout      from '../layouts/Layout.astro';
import ProductCard from '../components/catalog/ProductCard.astro';
import { allProducts } from '../data/products.js';

const totalCount = allProducts.length;

const categoryTabs = [
  { id: 'all',      label: 'All'                      },
  { id: 'nauwari',  label: 'Paithani Nauwari Kashta'  },
  { id: 'kashtha',  label: 'Designer Nauwari Kashta'  },
  { id: 'velvet',   label: 'Velvet Nauwari Kashta'    },
  { id: 'lehenga',  label: 'Lehenga'                  },
  { id: 'maternity',label: 'Maternity Gowns'          },
  { id: 'shaadi',   label: 'Shaadi Specials'          },
  { id: 'western',  label: 'Western & Themed'         },
];
---

<Layout
  title="Costume Catalog — wearit, Hinjewadi Pune"
  description="Rent costumes in Hinjewadi, Wakad, Baner & Balewadi Pune. Nauwari sarees, lehengas, maternity gowns, shaadi specials & western themed outfits. Washed & ironed. Book via WhatsApp."
>

  <div class="catalog-page">

    <!-- ── Page Header ── -->
    <div class="catalog-header">
      <div class="catalog-header__inner">
        <a href="/" class="catalog-back">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
          Back to home
        </a>
        <h1 class="catalog-header__title">Our Costume Collection</h1>
        <p class="catalog-header__sub">
          <span id="product-count">{totalCount}</span> costumes — washed, ironed &amp; festival-ready
        </p>
      </div>
    </div>

    <!-- ── Filter Bar ── -->
    <div class="filter-bar">
      <div class="filter-bar__inner">

        <!-- Category tabs -->
        <div class="filter-section">
          <p class="filter-label">Category</p>
          <div class="cat-tabs" role="tablist" aria-label="Filter by category">
            {categoryTabs.map((tab, i) => (
              <button
                class={`cat-tab${i === 0 ? ' cat-tab--active' : ''}`}
                data-category={tab.id}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                type="button"
              >
                {tab.label}
              </button>
            ))}
            <!-- Kids — coming soon, not clickable -->
            <span class="cat-tab cat-tab--soon" aria-disabled="true" title="Coming soon">
              Kids
              <span class="soon-badge">Soon</span>
            </span>
          </div>
        </div>

      </div>
    </div>

    <!-- ── Product Grid ── -->
    <div class="catalog-grid__wrap">
      <div class="catalog-grid__inner">
        <div class="catalog-grid" id="catalog-grid">
          {allProducts.map(product => (
            <div
              class="catalog-item"
              data-category={product.category}
              data-sizes={product.sizes.join(',')}
              data-sizetype={product.sizeType}
            >
              <ProductCard product={product} showCategory={true} />
            </div>
          ))}
        </div>

        <!-- Empty state -->
        <div class="empty-state" id="empty-state" style="display: none;">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <p class="empty-state__title">No costumes found</p>
          <p class="empty-state__sub">Try a different category or size filter</p>
          <button class="empty-state__reset" id="reset-filters" type="button">Reset filters</button>
        </div>
      </div>
    </div>

    <!-- ── Kids Coming Soon strip ── -->
    <div class="coming-soon-strip">
      <div class="coming-soon-strip__inner">
        <span class="coming-soon-strip__badge">🎭 Coming Soon</span>
        <p class="coming-soon-strip__text">
          <strong>Kids Fancy Dress</strong> — school annual day costumes, national leaders, fancy dress & more. Follow us on Instagram to be the first to know when it launches.
        </p>
      </div>
    </div>

  </div>

</Layout>

<script>
  // @ts-nocheck
  // Catalog filter — vanilla JS

  let activeCategory = 'all';

  const allItems  = Array.from(document.querySelectorAll('.catalog-item'));
  const catTabs   = Array.from(document.querySelectorAll('.cat-tab:not(.cat-tab--soon)'));
  const countEl   = document.getElementById('product-count');
  const emptyEl   = document.getElementById('empty-state');
  const resetBtn  = document.getElementById('reset-filters');

  function applyFilters() {
    let visible = 0;

    allItems.forEach(item => {
      const cat  = item.getAttribute('data-category');
      // Shaadi = collection of nauwari + velvet + kashtha + lehenga
      const shaadiCategories = ['nauwari', 'velvet', 'kashtha', 'lehenga'];
      const show = activeCategory === 'all'
        || cat === activeCategory
        || (activeCategory === 'shaadi' && shaadiCategories.includes(cat));
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (countEl) countEl.textContent = String(visible);
    if (emptyEl) emptyEl.style.display = visible === 0 ? 'flex' : 'none';
  }

  catTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      catTabs.forEach(t => {
        t.classList.remove('cat-tab--active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('cat-tab--active');
      tab.setAttribute('aria-selected', 'true');
      activeCategory = tab.getAttribute('data-category');
      applyFilters();
    });
  });

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      activeCategory = 'all';
      catTabs.forEach((t, i) => {
        t.classList.toggle('cat-tab--active', i === 0);
        t.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
      });
      applyFilters();
    });
  }

  // URL param — e.g. /catalog?category=nauwari
  const params   = new URLSearchParams(window.location.search);
  const catParam = params.get('category') ?? params.get('tab');
  if (catParam) {
    const matchTab = catTabs.find(t => t.getAttribute('data-category') === catParam);
    if (matchTab) {
      catTabs.forEach(t => {
        t.classList.remove('cat-tab--active');
        t.setAttribute('aria-selected', 'false');
      });
      matchTab.classList.add('cat-tab--active');
      matchTab.setAttribute('aria-selected', 'true');
      activeCategory = catParam;
      applyFilters();
    }
  }
</script>

<style>
  .catalog-page { background: #FAF8F5; min-height: 100vh; }

  .catalog-header { background: #FAF8F5; border-bottom: 0.5px solid rgba(42,17,36,0.08); padding: 1.5rem 0 1.25rem; }
  .catalog-header__inner { max-width: 1200px; margin-inline: auto; padding-inline: 1.25rem; }
  @media (min-width: 768px) { .catalog-header__inner { padding-inline: 3rem; } }

  .catalog-back { display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: rgba(42,17,36,0.45); text-decoration: none; margin-bottom: 0.875rem; transition: color 0.15s; }
  .catalog-back:hover { color: #D4AF37; }

  .catalog-header__title { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(1.5rem, 4vw, 2.25rem); font-weight: 700; color: #2A1124; margin: 0 0 0.375rem; }
  .catalog-header__sub { font-size: 0.875rem; color: rgba(42,17,36,0.45); margin: 0; }

  .filter-bar { background: #fff; border-bottom: 0.5px solid rgba(42,17,36,0.08); position: sticky; top: 0; z-index: 10; }
  .filter-bar__inner { max-width: 1200px; margin-inline: auto; padding: 0.875rem 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; }
  @media (min-width: 768px) { .filter-bar__inner { flex-direction: row; align-items: center; gap: 2rem; padding: 0.875rem 3rem; } }

  .filter-section { display: flex; align-items: center; gap: 0.75rem; overflow: hidden; }
  .filter-label { font-size: 0.6875rem; font-weight: 600; color: rgba(42,17,36,0.4); letter-spacing: 0.05em; text-transform: uppercase; white-space: nowrap; flex-shrink: 0; }

  .cat-tabs { display: flex; gap: 0.25rem; overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none; flex-wrap: nowrap; }
  .cat-tabs::-webkit-scrollbar { display: none; }

  .cat-tab { padding: 0.4375rem 1rem; font-size: 0.8125rem; font-weight: 500; color: rgba(42,17,36,0.45); background: transparent; border: 1px solid rgba(42,17,36,0.12); border-radius: 9999px; cursor: pointer; white-space: nowrap; transition: all 0.15s; min-height: 36px; outline: none; font-family: inherit; display: inline-flex; align-items: center; gap: 0.375rem; flex-shrink: 0; }
  .cat-tab:hover { color: #D4AF37; border-color: rgba(212,175,55,0.3); }
  .cat-tab--active { background: #D4AF37 !important; border-color: #D4AF37 !important; color: #fff !important; font-weight: 600 !important; }

  .cat-tab--soon { cursor: not-allowed; opacity: 0.45; }
  .cat-tab--soon:hover { color: rgba(42,17,36,0.45); border-color: rgba(42,17,36,0.12); }

  .soon-badge { font-size: 0.5625rem; font-weight: 700; background: #D4AF37; color: #fff; padding: 0.15rem 0.4rem; border-radius: 9999px; }

  .catalog-grid__wrap { padding: 1.5rem 0 2rem; }
  .catalog-grid__inner { max-width: 1200px; margin-inline: auto; padding-inline: 1.25rem; }
  @media (min-width: 768px) { .catalog-grid__inner { padding-inline: 3rem; } }

  .catalog-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.875rem; }
  @media (min-width: 768px) { .catalog-grid { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } }
  @media (min-width: 1024px) { .catalog-grid { grid-template-columns: repeat(4, 1fr); } }

  .empty-state { flex-direction: column; align-items: center; justify-content: center; padding: 4rem 1rem; gap: 0.75rem; color: rgba(42,17,36,0.35); text-align: center; }
  .empty-state__title { font-size: 1.125rem; font-weight: 600; color: #2A1124; margin: 0; }
  .empty-state__sub { font-size: 0.875rem; margin: 0; }
  .empty-state__reset { margin-top: 0.5rem; background: #D4AF37; color: #fff; border: none; border-radius: 0.5rem; padding: 0.625rem 1.5rem; font-size: 0.875rem; font-weight: 600; cursor: pointer; font-family: inherit; }

  .coming-soon-strip { background: rgba(201, 168, 76, 0.08); border-top: 0.5px solid rgba(201, 168, 76, 0.2); padding: 1.125rem 0; }
  .coming-soon-strip__inner { max-width: 1200px; margin-inline: auto; padding-inline: 1.25rem; display: flex; align-items: center; gap: 0.875rem; flex-wrap: wrap; }
  @media (min-width: 768px) { .coming-soon-strip__inner { padding-inline: 3rem; } }
  .coming-soon-strip__badge { font-size: 0.8125rem; font-weight: 600; color: #D4AF37; white-space: nowrap; flex-shrink: 0; }
  .coming-soon-strip__text { font-size: 0.8125rem; color: rgba(42,17,36,0.55); margin: 0; line-height: 1.6; }
</style>