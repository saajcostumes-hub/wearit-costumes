---
// @ts-nocheck
// src/pages/about.astro — Sprint 3 · Step 2
// ─────────────────────────────────────────────
// Founder story + location + contact + mission
// ─────────────────────────────────────────────

import Layout   from '../layouts/Layout.astro';
import { BUSINESS } from '../lib/constants.js';

const waLink  = `https://wa.me/${BUSINESS.whatsapp.waMeNumber}`;
const telLink = `tel:+${String(BUSINESS.whatsapp.waMeNumber).replace(/\D/g,'')}`;

const values = [
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>`,
    color: '#E85D26',
    title: 'Washed & Ironed',
    desc:  'Every costume is freshly laundered and pressed before handover. No exceptions.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
    color: '#E85D26',
    title: 'Proudly Local',
    desc:  'Based in Maan, Hinjewadi. We know this neighbourhood and we\'re invested in it.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    color: '#C9A84C',
    title: 'Traditional Marathi',
    desc:  'Specializing in Nauwari sarees, Shivaji Maharaj sets — cultural costumes done right.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    color: '#25D366',
    title: 'WhatsApp-First',
    desc:  'No complicated checkouts. Browse, choose, WhatsApp us. Done in 3 steps.',
  },
];
---

<Layout
  title="About Us — wearit Costume Rentals, Maan Hinjewadi Pune"
  description="wearit is a home-based premium costume rental business in Maan, Hinjewadi. Traditional Marathi costumes, kids fancy dress. Washed & ironed before every rental. WhatsApp-first booking."
>

  <div class="about-page">

    <!-- ── Page Header ── -->
    <div class="page-header">
      <div class="page-header__inner">
        <a href="/" class="back-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
          Back to home
        </a>
        <h1 class="page-header__title">About wearit</h1>
        <p class="page-header__sub">A small business with a big commitment to quality</p>
      </div>
    </div>

    <div class="about-inner">

      <!-- ── Founder Story ── -->
      <section class="founder-section" aria-labelledby="founder-title">
        <div class="founder-card">
          <!-- Avatar placeholder -->
          <div class="founder-avatar" aria-hidden="true">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
          <div class="founder-card__content">
            <h2 class="founder-card__title" id="founder-title">Why I started wearit</h2>
            <p class="founder-card__text">
              Every year during Ganesh Chaturthi and Shiv Jayanti, my family would spend hours searching Pune for a good Nauwari saree or a proper Shivaji Maharaj set — only to find shops that were either far away, had limited stock, or returned costumes that clearly hadn't been cleaned.
            </p>
            <p class="founder-card__text">
              wearit started from that frustration. I wanted to create something simple: a place where families in Hinjewadi and Wakad could find quality festival costumes — traditional, cleaned, and ready to wear — without driving to the other side of Pune.
            </p>
            <p class="founder-card__text">
              We're home-based, locally rooted, and genuinely proud of what we offer. Every costume that leaves our door is washed, ironed, and inspected. That's our promise.
            </p>
            <p class="founder-card__sig">— Dinesh, Founder · wearit, Maan</p>
          </div>
        </div>
      </section>

      <!-- ── Our Values ── -->
      <section aria-labelledby="values-title">
        <h2 class="section-title" id="values-title">What we stand for</h2>
        <div class="values-grid">
          {values.map(v => (
            <div class="value-card">
              <div class="value-card__icon" style={`color: ${v.color}`}>
                <Fragment set:html={v.icon} />
              </div>
              <h3 class="value-card__title">{v.title}</h3>
              <p class="value-card__desc">{v.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ── Location ── -->
      <section aria-labelledby="location-title">
        <h2 class="section-title" id="location-title">Find us</h2>
        <p class="section-sub">We're based in Maan — right in the heart of the Hinjewadi IT belt.</p>

        <div class="location-grid">
          <!-- Map embed -->
          <div class="map-wrap">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3782.2898!2d73.7256!3d18.5679!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bc2bbca89cebd01%3A0x4dbed0cdc5aa0ae5!2sMaan%2C%20Pune%2C%20Maharashtra!5e0!3m2!1sen!2sin!4v1234567890"
              width="100%"
              height="280"
              style="border:0; border-radius: 0.875rem;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="wearit location — Maan, Hinjewadi, Pune"
            ></iframe>
          </div>

          <!-- Location details -->
          <div class="location-details">
            <div class="location-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E85D26" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <div>
                <p class="location-item__label">Pickup Location</p>
                <p class="location-item__value">{BUSINESS.pickupLocation.area}, {BUSINESS.pickupLocation.city}<br/>PIN {BUSINESS.pickupLocation.pin}</p>
                <p class="location-item__hint">Near Hinjewadi Phase 2 — exact address shared on WhatsApp after booking</p>
              </div>
            </div>

            <div class="location-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E85D26" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <div>
                <p class="location-item__label">Hours</p>
                <p class="location-item__value">{BUSINESS.hours.weekdays.label}: {BUSINESS.hours.weekdays.open} – {BUSINESS.hours.weekdays.close}</p>
                <p class="location-item__value">{BUSINESS.hours.sunday.label}: {BUSINESS.hours.sunday.note}</p>
              </div>
            </div>

            <div class="location-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E85D26" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/></svg>
              <div>
                <p class="location-item__label">We serve</p>
                <p class="location-item__value">{BUSINESS.serviceAreas.join(' · ')}</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Contact ── -->
      <section aria-labelledby="contact-title">
        <h2 class="section-title" id="contact-title">Get in touch</h2>
        <p class="section-sub">We're just a WhatsApp message away.</p>

        <div class="contact-cards">
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="contact-card contact-card--wa">
            <div class="contact-card__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="white" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/>
              </svg>
            </div>
            <div>
              <p class="contact-card__label">WhatsApp</p>
              <p class="contact-card__value">{BUSINESS.whatsapp.display}</p>
              <p class="contact-card__hint">Fastest way to reach us</p>
            </div>
          </a>

          <a href={telLink} class="contact-card contact-card--call">
            <div class="contact-card__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.45 2 2 0 0 1 3.59 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.29 6.29l1.12-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <div>
              <p class="contact-card__label">Call us</p>
              <p class="contact-card__value">{BUSINESS.whatsapp.display}</p>
              <p class="contact-card__hint">Mon – Sat, 10am – 8pm</p>
            </div>
          </a>
        </div>
      </section>

    </div>
  </div>

</Layout>

<style>
  .about-page { background: #FDF6EE; min-height: 100vh; }

  /* ── Header ── */
  .page-header {
    background: #fff;
    border-bottom: 0.5px solid rgba(26,26,46,0.08);
    padding: 1.5rem 0 1.25rem;
  }

  .page-header__inner {
    max-width: 900px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 768px) { .page-header__inner { padding-inline: 3rem; } }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: rgba(26,26,46,0.45);
    text-decoration: none;
    margin-bottom: 0.875rem;
    transition: color 0.15s;
  }

  .back-link:hover { color: #E85D26; }

  .page-header__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    color: #1A1A2E;
    margin: 0 0 0.375rem;
  }

  .page-header__sub { font-size: 0.9375rem; color: rgba(26,26,46,0.45); margin: 0; }

  /* ── Inner ── */
  .about-inner {
    max-width: 900px;
    margin-inline: auto;
    padding: 2rem 1.25rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  @media (min-width: 768px) { .about-inner { padding: 2.5rem 3rem 5rem; } }

  .section-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.25rem, 3vw, 1.625rem);
    font-weight: 700;
    color: #1A1A2E;
    margin: 0 0 0.25rem;
  }

  .section-sub { font-size: 0.875rem; color: rgba(26,26,46,0.42); margin: 0 0 1.5rem; }

  /* ── Founder card ── */
  .founder-card {
    background: #fff;
    border: 0.5px solid rgba(26,26,46,0.08);
    border-radius: 1rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: 0 2px 12px rgba(26,26,46,0.06);
  }

  @media (min-width: 640px) { .founder-card { flex-direction: row; gap: 1.5rem; } }

  .founder-avatar {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: linear-gradient(145deg, #F5E6D0, #EDD5B8);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: rgba(26,26,46,0.3);
    border: 2px solid rgba(232,93,38,0.15);
  }

  .founder-card__content { display: flex; flex-direction: column; gap: 0.75rem; }

  .founder-card__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #1A1A2E;
    margin: 0;
  }

  .founder-card__text {
    font-size: 0.9375rem;
    color: rgba(26,26,46,0.65);
    line-height: 1.75;
    margin: 0;
  }

  .founder-card__sig {
    font-size: 0.875rem;
    font-weight: 600;
    color: #E85D26;
    margin: 0;
    padding-top: 0.25rem;
  }

  /* ── Values grid ── */
  .values-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.875rem;
  }

  @media (min-width: 768px) { .values-grid { grid-template-columns: repeat(4, 1fr); } }

  .value-card {
    background: #fff;
    border: 0.5px solid rgba(26,26,46,0.08);
    border-radius: 0.875rem;
    padding: 1.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    box-shadow: 0 1px 4px rgba(26,26,46,0.05);
  }

  .value-card__icon { display: flex; }

  .value-card__title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1A1A2E;
    margin: 0;
  }

  .value-card__desc {
    font-size: 0.8125rem;
    color: rgba(26,26,46,0.5);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Location ── */
  .location-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) { .location-grid { grid-template-columns: 1fr 1fr; } }

  .map-wrap {
    border-radius: 0.875rem;
    overflow: hidden;
    border: 0.5px solid rgba(26,26,46,0.08);
    box-shadow: 0 2px 12px rgba(26,26,46,0.06);
  }

  .location-details {
    background: #fff;
    border: 0.5px solid rgba(26,26,46,0.08);
    border-radius: 0.875rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: 0 1px 4px rgba(26,26,46,0.05);
  }

  .location-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .location-item svg { flex-shrink: 0; margin-top: 0.1rem; }

  .location-item__label {
    font-size: 0.6875rem;
    font-weight: 600;
    color: rgba(26,26,46,0.38);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.25rem;
  }

  .location-item__value {
    font-size: 0.875rem;
    color: #1A1A2E;
    font-weight: 500;
    margin: 0 0 0.2rem;
    line-height: 1.5;
  }

  .location-item__hint {
    font-size: 0.75rem;
    color: rgba(26,26,46,0.4);
    margin: 0;
    line-height: 1.5;
  }

  /* ── Contact cards ── */
  .contact-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
  }

  @media (min-width: 640px) { .contact-cards { grid-template-columns: repeat(2, 1fr); } }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem;
    border-radius: 0.875rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    border: 0.5px solid transparent;
  }

  .contact-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(26,26,46,0.1); }

  .contact-card--wa   { background: #25D366; }
  .contact-card--call { background: #1A1A2E; }

  .contact-card__icon {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contact-card__label {
    font-size: 0.6875rem;
    color: rgba(255,255,255,0.65);
    font-weight: 500;
    margin: 0 0 0.2rem;
  }

  .contact-card__value {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.2rem;
  }

  .contact-card__hint {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.5);
    margin: 0;
  }
</style>