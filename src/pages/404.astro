---
// @ts-nocheck
// src/pages/404.astro — Sprint 3 · Step 5
// Custom on-brand 404 page
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found — wearit"
  description="This page doesn't exist. Browse our costume collection instead."
  noindex={true}
>
  <div class="not-found">

    <!-- Big 404 -->
    <div class="not-found__number" aria-hidden="true">404</div>

    <!-- Icon -->
    <div class="not-found__icon" aria-hidden="true">
      <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
        <circle cx="12" cy="13" r="4"/>
      </svg>
    </div>

    <h1 class="not-found__title">Costume not found</h1>
    <p class="not-found__sub">
      This page doesn't exist — but we have plenty of great costumes that do.
    </p>

    <div class="not-found__actions">
      <a href="/catalog" class="btn-primary">Browse collection →</a>
      <a href="/"        class="btn-ghost">Back to home</a>
    </div>

  </div>
</Layout>

<style>
  .not-found {
    background: #FDF6EE;
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1.25rem;
    gap: 1rem;
  }

  .not-found__number {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(5rem, 20vw, 9rem);
    font-weight: 700;
    color: rgba(232, 93, 38, 0.12);
    line-height: 1;
    margin-bottom: -1rem;
  }

  .not-found__icon {
    color: rgba(26, 26, 46, 0.2);
    margin-bottom: 0.5rem;
  }

  .not-found__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    color: #1A1A2E;
    margin: 0;
  }

  .not-found__sub {
    font-size: 0.9375rem;
    color: rgba(26, 26, 46, 0.5);
    max-width: 36ch;
    line-height: 1.6;
    margin: 0;
  }

  .not-found__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 400px) {
    .not-found__actions { flex-direction: row; }
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    background: #E85D26;
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 0.875rem 1.75rem;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(232, 93, 38, 0.3);
    transition: box-shadow 0.2s ease, transform 0.15s ease;
    min-height: 44px;
  }

  .btn-primary:hover {
    box-shadow: 0 6px 22px rgba(232, 93, 38, 0.4);
    transform: translateY(-1px);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    color: rgba(26, 26, 46, 0.5);
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.875rem 1.5rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid rgba(26, 26, 46, 0.15);
    transition: border-color 0.15s ease, color 0.15s ease;
    min-height: 44px;
  }

  .btn-ghost:hover {
    border-color: #E85D26;
    color: #E85D26;
  }
</style>