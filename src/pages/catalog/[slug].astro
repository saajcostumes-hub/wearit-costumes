  .product-info__desc { font-size: 0.9375rem; color: rgba(42,17,36,0.6); line-height: 1.7; margin: 0; }
  .product-info__tags { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .product-tag { font-size: 0.6875rem; background: rgba(42,17,36,0.06); color: rgba(42,17,36,0.45); padding: 0.25rem 0.625rem; border-radius: 9999px; border: 0.5px solid rgba(42,17,36,0.1); }

