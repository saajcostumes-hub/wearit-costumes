  .gallery__thumb {
    flex-shrink: 0;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 2px solid rgba(42,17,36,0.1);
    cursor: pointer;
