    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(34, 197, 94, 0.08);
    border: 0.5px solid rgba(34, 197, 94, 0.25);
    border-radius: 0.5rem;
    padding: 0.625rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #15803d;
  }

  .detail-page { background: #FAF8F5; min-height: 100vh; }

  /* Breadcrumb */
  .breadcrumb { border-bottom: 0.5px solid rgba(42,17,36,0.08); background: #fff; padding: 0.75rem 0; }
  .breadcrumb__inner { max-width: 1200px; margin-inline: auto; padding-inline: 1.25rem; display: flex; align-items: center; gap: 0.375rem; flex-wrap: wrap; font-size: 0.8125rem; }
  @media (min-width: 768px) { .breadcrumb__inner { padding-inline: 3rem; } }
  .breadcrumb__link { color: rgba(42,17,36,0.5); text-decoration: none; transition: color 0.15s; }
  .breadcrumb__link:hover { color: #D4AF37; }
  .breadcrumb__sep { color: rgba(42,17,36,0.25); }
  .breadcrumb__current { color: #2A1124; font-weight: 500; }

  /* Main grid */
  .detail-grid { max-width: 1200px; margin-inline: auto; padding: 1.5rem 1.25rem 3rem; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px) { .detail-grid { grid-template-columns: 1fr 380px; gap: 2.5rem; padding: 2rem 3rem 4rem; align-items: start; } }

  .detail-left { display: flex; flex-direction: column; gap: 1.25rem; }

  /* ═══ GALLERY ═══ */
  .gallery { display: flex; flex-direction: column; gap: 0.625rem; }

  .gallery__main {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    border: 0.5px solid rgba(42,17,36,0.08);
    background: linear-gradient(145deg, #F5E6D0, #EDD5B8);
    aspect-ratio: 4 / 3;
    cursor: grab;
  }

  .gallery__main:active { cursor: grabbing; }

  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease;
  }

  .gallery__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    color: rgba(42,17,36,0.22);
  }

  .gallery__placeholder p { font-size: 0.875rem; margin: 0; }

  /* Badges */
  .gallery__badges { position: absolute; top: 0.875rem; left: 0.875rem; display: flex; gap: 0.375rem; flex-wrap: wrap; }
  .img-badge { font-size: 0.625rem; font-weight: 700; padding: 0.3rem 0.7rem; border-radius: 9999px; backdrop-filter: blur(4px); }
  .img-badge--exclusive { background: rgba(255,255,255,0.92); color: #D4AF37; }
  .img-badge--price     { background: rgba(255,255,255,0.92); color: #D4AF37; }
  .img-badge--cat       { background: rgba(42,17,36,0.7); color: #fff; }

  /* Nav arrows */
  .gallery__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgba(255,255,255,0.92);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(42,17,36,0.15);
