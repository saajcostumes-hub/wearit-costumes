---
// @ts-nocheck
// src/pages/catalog/[slug].astro
// ─────────────────────────────────────────────
// Dynamic product detail page — one per product slug
// Sprint 2 · Step 8
//
// getStaticPaths → generates all 17 product pages at build time
// Layout: mobile single-col, desktop 2-col (image | booking panel)
// Wires: SizeSelector → DatePicker → PriceBreakdown → WhatsAppBooking
// ─────────────────────────────────────────────

import Layout          from '../../layouts/Layout.astro';
import SizeSelector    from '../../components/catalog/SizeSelector.astro';
import DatePicker      from '../../components/catalog/DatePicker.astro';
import PriceBreakdown  from '../../components/catalog/PriceBreakdown.astro';
import WhatsAppBooking from '../../components/catalog/WhatsAppBooking.astro';
import { allProducts, getProductBySlug, formatPrice } from '../../data/products.js';

// Generate all product pages at build time
export function getStaticPaths() {
  return allProducts.map(product => ({
    params: { slug: product.slug },
    props:  { product },
  }));
}

const { product } = Astro.props;

// Precompute display values in frontmatter
const priceDisplay   = formatPrice(product.price);
const depositDisplay = formatPrice(product.deposit);

const categoryLabelMap = {
  womens:      "Women's",
  traditional: 'Traditional',
  kids:        'Kids',
};
const categoryLabel = categoryLabelMap[product.category] ?? product.category;

// Related products — same category, exclude current
const related = allProducts
  .filter(p => p.category === product.category && p.id !== product.id)
  .slice(0, 3);
---

<Layout
  title={`${product.name} — wearit Costume Rentals, Hinjewadi Pune`}
  description={`Rent ${product.name} in Hinjewadi, Wakad & Baner, Pune. From ${formatPrice(product.price)}/event. 100% refundable deposit. Washed & ironed. WhatsApp booking.`}
>

  <div class="detail-page">

    <!-- ── Breadcrumb ── -->
    <div class="breadcrumb">
      <div class="breadcrumb__inner">
        <a href="/" class="breadcrumb__link">Home</a>
        <span class="breadcrumb__sep">›</span>
        <a href={`/catalog?category=${product.category}`} class="breadcrumb__link">
          {categoryLabel}
        </a>
        <span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">{product.name}</span>
      </div>
    </div>

    <!-- ── Main content — 2-col on desktop ── -->
    <div class="detail-grid">

      <!-- LEFT: Product image + info -->
      <div class="detail-left">

        <!-- Product image -->
        <div class="product-image">
          {product.image ? (
            <img
              src={product.image}
              alt={product.alt}
              class="product-image__img"
              loading="eager"
              width="600"
              height="450"
            />
          ) : (
            <div class="product-image__placeholder">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
              <p>Your costume photography here</p>
            </div>
          )}

          <!-- Badges overlay -->
          <div class="product-image__badges">
            {product.badge && (
              <span class={`img-badge img-badge--${product.badgeType}`}>
                {product.badge}
              </span>
            )}
            <span class="img-badge img-badge--cat">{categoryLabel}</span>
          </div>
        </div>

        <!-- Product info -->
        <div class="product-info">
          <h1 class="product-info__title">{product.name}</h1>
          <p class="product-info__desc">{product.description}</p>

          <!-- Tags -->
          {product.tags && product.tags.length > 0 && (
            <div class="product-info__tags">
              {product.tags.map(tag => (
                <span class="product-tag">{tag}</span>
              ))}
            </div>
          )}

          <!-- Quick price reference (mobile-friendly summary) -->
          <div class="product-info__price-row">
            <div>
              <span class="product-info__price">{priceDisplay}</span>
              <span class="product-info__per"> /event</span>
            </div>
            <div class="product-info__deposit">
              Deposit: {depositDisplay}
              <span class="product-info__refund">100% refundable</span>
            </div>
          </div>
        </div>

      </div><!-- /detail-left -->

      <!-- RIGHT: Booking panel (sticky on desktop) -->
      <div class="detail-right">
        <div class="booking-panel" id="booking-panel">

          <!-- Panel header -->
          <div class="booking-panel__header">
            <p class="booking-panel__name">{product.name}</p>
            <p class="booking-panel__price">
              {priceDisplay}<span class="booking-panel__per"> /event</span>
            </p>
          </div>

          <div class="booking-panel__divider"></div>

          <!-- Size selector -->
          <SizeSelector
            sizes={product.sizes}
            sizeType={product.sizeType}
            productName={product.name}
          />

          <div class="booking-panel__divider"></div>

          <!-- Date picker -->
          <DatePicker
            price={product.price}
            deposit={product.deposit}
          />

          <div class="booking-panel__divider"></div>

          <!-- Price breakdown -->
          <PriceBreakdown
            price={product.price}
            deposit={product.deposit}
          />

          <div class="booking-panel__divider"></div>

          <!-- WhatsApp booking CTA -->
          <WhatsAppBooking product={product} />

          <!-- Hygiene note -->
          <p class="booking-panel__hygiene">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            Washed &amp; ironed before every rental
          </p>

        </div>
      </div><!-- /detail-right -->

    </div><!-- /detail-grid -->

    <!-- ── Related products ── -->
    {related.length > 0 && (
      <div class="related-section">
        <div class="related-section__inner">
          <h2 class="related-section__title">More in {categoryLabel}</h2>
          <div class="related-grid">
            {related.map(item => (
              <a href={`/catalog/${item.slug}`} class="related-card">
                <div class="related-card__img"></div>
                <div class="related-card__body">
                  <p class="related-card__name">{item.name}</p>
                  <p class="related-card__price">{formatPrice(item.price)}<span> /event</span></p>
                </div>
              </a>
            ))}
          </div>
          <div class="related-section__link">
            <a href={`/catalog?category=${product.category}`}>
              View all {categoryLabel.toLowerCase()} costumes →
            </a>
          </div>
        </div>
      </div>
    )}

  </div>

</Layout>

<style>
  /* ═══════════════════════════════════════════
     PAGE WRAPPER
  ═══════════════════════════════════════════ */
  .detail-page {
    background: #FDF6EE;
    min-height: 100vh;
  }

  /* ═══════════════════════════════════════════
     BREADCRUMB
  ═══════════════════════════════════════════ */
  .breadcrumb {
    border-bottom: 0.5px solid rgba(26,26,46,0.08);
    background: #fff;
    padding: 0.75rem 0;
  }

  .breadcrumb__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-wrap: wrap;
    font-size: 0.8125rem;
  }

  @media (min-width: 768px) {
    .breadcrumb__inner { padding-inline: 3rem; }
  }

  .breadcrumb__link {
    color: rgba(26,26,46,0.5);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb__link:hover { color: #E85D26; }
  .breadcrumb__sep        { color: rgba(26,26,46,0.25); }
  .breadcrumb__current    { color: #1A1A2E; font-weight: 500; }

  /* ═══════════════════════════════════════════
     MAIN GRID — single col mobile, 2-col desktop
  ═══════════════════════════════════════════ */
  .detail-grid {
    max-width: 1200px;
    margin-inline: auto;
    padding: 1.5rem 1.25rem 3rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .detail-grid {
      grid-template-columns: 1fr 380px;
      gap: 2.5rem;
      padding: 2rem 3rem 4rem;
      align-items: start;
    }
  }

  /* ═══════════════════════════════════════════
     LEFT — IMAGE + INFO
  ═══════════════════════════════════════════ */
  .detail-left {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* ── Image ── */
  .product-image {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    border: 0.5px solid rgba(26,26,46,0.08);
  }

  .product-image__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .product-image__placeholder {
    background: linear-gradient(145deg, #F5E6D0, #EDD5B8);
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    color: rgba(26,26,46,0.25);
  }

  .product-image__placeholder p {
    font-size: 0.875rem;
    margin: 0;
  }

  .product-image__badges {
    position: absolute;
    top: 0.875rem;
    left: 0.875rem;
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .img-badge {
    font-size: 0.625rem;
    font-weight: 700;
    padding: 0.3rem 0.7rem;
    border-radius: 9999px;
    backdrop-filter: blur(4px);
  }

  .img-badge--exclusive { background: rgba(255,255,255,0.92); color: #E85D26; }
  .img-badge--price     { background: rgba(255,255,255,0.92); color: #C9A84C; }
  .img-badge--cat       { background: rgba(26,26,46,0.7);     color: #fff;    }

  /* ── Product info ── */
  .product-info {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .product-info__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    color: #1A1A2E;
    margin: 0;
    line-height: 1.2;
  }

  .product-info__desc {
    font-size: 0.9375rem;
    color: rgba(26,26,46,0.6);
    line-height: 1.7;
    margin: 0;
  }

  .product-info__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .product-tag {
    font-size: 0.6875rem;
    background: rgba(26,26,46,0.06);
    color: rgba(26,26,46,0.45);
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    border: 0.5px solid rgba(26,26,46,0.1);
  }

  .product-info__price-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.875rem;
    background: #fff;
    border-radius: 0.75rem;
    border: 0.5px solid rgba(26,26,46,0.08);
    flex-wrap: wrap;
  }

  .product-info__price {
    font-size: 1.5rem;
    font-weight: 700;
    color: #E85D26;
  }

  .product-info__per { font-size: 0.875rem; color: rgba(26,26,46,0.35); }

  .product-info__deposit {
    font-size: 0.875rem;
    color: rgba(26,26,46,0.5);
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .product-info__refund {
    font-size: 0.6875rem;
    font-weight: 600;
    background: rgba(34,197,94,0.1);
    color: #16a34a;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }

  /* ═══════════════════════════════════════════
     RIGHT — BOOKING PANEL
  ═══════════════════════════════════════════ */
  .detail-right {
    position: relative;
  }

  @media (min-width: 768px) {
    .detail-right { position: sticky; top: 5rem; }
  }

  .booking-panel {
    background: #fff;
    border: 0.5px solid rgba(26,26,46,0.1);
    border-radius: 1.125rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    box-shadow: 0 4px 24px rgba(26,26,46,0.07);
  }

  .booking-panel__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .booking-panel__name {
    font-size: 1rem;
    font-weight: 600;
    color: #1A1A2E;
    margin: 0;
  }

  .booking-panel__price {
    font-size: 1.375rem;
    font-weight: 700;
    color: #E85D26;
    margin: 0;
    white-space: nowrap;
  }

  .booking-panel__per {
    font-size: 0.8125rem;
    font-weight: 400;
    color: rgba(26,26,46,0.35);
  }

  .booking-panel__divider {
    height: 0.5px;
    background: rgba(26,26,46,0.07);
    margin: 0;
  }

  .booking-panel__hygiene {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: rgba(26,26,46,0.38);
    margin: 0;
    text-align: center;
    justify-content: center;
  }

  /* ═══════════════════════════════════════════
     RELATED PRODUCTS
  ═══════════════════════════════════════════ */
  .related-section {
    border-top: 0.5px solid rgba(26,26,46,0.08);
    padding: 2.5rem 0 3rem;
    background: #FDF6EE;
  }

  .related-section__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 768px) {
    .related-section__inner { padding-inline: 3rem; }
  }

  .related-section__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.375rem;
    font-weight: 700;
    color: #1A1A2E;
    margin: 0 0 1.25rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.875rem;
    margin-bottom: 1.125rem;
  }

  @media (min-width: 768px) {
    .related-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .related-card {
    background: #fff;
    border: 0.5px solid rgba(26,26,46,0.08);
    border-radius: 0.875rem;
    overflow: hidden;
    text-decoration: none;
    transition: box-shadow 0.2s ease, transform 0.15s ease;
  }

  .related-card:hover {
    box-shadow: 0 4px 16px rgba(26,26,46,0.1);
    transform: translateY(-2px);
  }

  .related-card__img {
    background: linear-gradient(145deg, #F5E6D0, #EDD5B8);
    aspect-ratio: 4 / 3;
  }

  .related-card__body {
    padding: 0.75rem;
  }

  .related-card__name {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1A1A2E;
    margin: 0 0 0.25rem;
  }

  .related-card__price {
    font-size: 1rem;
    font-weight: 700;
    color: #E85D26;
    margin: 0;
  }

  .related-card__price span {
    font-size: 0.75rem;
    font-weight: 400;
    color: rgba(26,26,46,0.35);
  }

  .related-section__link {
    text-align: center;
  }

  .related-section__link a {
    font-size: 0.875rem;
    font-weight: 600;
    color: #E85D26;
    text-decoration: none;
  }

  .related-section__link a:hover {
    text-decoration: underline;
  }
</style>