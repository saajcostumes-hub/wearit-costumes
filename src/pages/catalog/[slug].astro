  .gallery__nav:hover { background: #fff; }
  .gallery__nav--prev { left: 0.625rem; }
  .gallery__nav--next { right: 0.625rem; }

  /* Counter */
  .gallery__counter {
    position: absolute;
    bottom: 0.625rem;
    right: 0.75rem;
    background: rgba(42,17,36,0.6);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
  }

  /* Thumbnails */
  .gallery__thumbs {
    display: flex;
