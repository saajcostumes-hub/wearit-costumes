---
// @ts-nocheck
// src/pages/catalog/[slug].astro — Sprint 4 update
// ─────────────────────────────────────────────
// Changes from Sprint 2:
//   - Price info COMMENTED OUT (uncomment when ready to show pricing)
//   - Photo gallery added (up to 5 images, swipeable on mobile)
// ─────────────────────────────────────────────

import Layout          from '../../layouts/Layout.astro';
// SizeSelector not needed — all products are Free Size (auto-selected)
// import SizeSelector from '../../components/catalog/SizeSelector.astro';
import DatePicker      from '../../components/catalog/DatePicker.astro';
// import PriceBreakdown  from '../../components/catalog/PriceBreakdown.astro'; // HIDDEN — uncomment when ready to show pricing
import WhatsAppBooking from '../../components/catalog/WhatsAppBooking.astro';
import { allProducts, getProductBySlug, formatPrice } from '../../data/products.js';

export function getStaticPaths() {
  return allProducts.map(product => ({
    params: { slug: product.slug },
    props:  { product },
  }));
}

const { product } = Astro.props;

// Price display — COMMENTED OUT for Phase 1 launch
// Uncomment these when ready to show pricing publicly
// const priceDisplay   = formatPrice(product.price);
// const depositDisplay = formatPrice(product.deposit);

const categoryLabelMap = {
  nauwari:   'Nauwari Sarees',
  lehenga:   'Lehenga',
  maternity: 'Maternity Gowns',
  shaadi:    'Shaadi Specials',
  western:   'Western & Themed',
};
const categoryLabel = categoryLabelMap[product.category] ?? product.category;

// Gallery — up to 5 images from product.images array
const galleryImages  = product.images ?? [];
const productColors  = product.colors  ?? [];
const hasColors      = productColors.length > 0;
const hasImages      = galleryImages.length > 0;
const thumbCount     = Math.min(5, galleryImages.length);

// Related products — same category, exclude current, max 3
const related = allProducts
  .filter(p => p.category === product.category && p.id !== product.id)
  .slice(0, 3);
---

<Layout
  title={`${product.name} — wearit Costume Rentals, Hinjewadi Pune`}
  description={`Rent ${product.name} in Hinjewadi, Wakad & Baner, Pune. Washed & ironed. 100% refundable deposit. WhatsApp booking.`}
>

  <div class="detail-page">

    <!-- ── Breadcrumb ── -->
    <div class="breadcrumb">
      <div class="breadcrumb__inner">
        <a href="/" class="breadcrumb__link">Home</a>
        <span class="breadcrumb__sep">›</span>
        <a href={`/catalog?category=${product.category}`} class="breadcrumb__link">{categoryLabel}</a>
        <span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">{product.name}</span>
      </div>
    </div>

    <!-- ── Main grid ── -->
    <div class="detail-grid">

      <!-- LEFT — Gallery + info -->
      <div class="detail-left">

        <!-- ═══ PHOTO GALLERY ═══ -->
        <div class="gallery" id="gallery">

          <!-- Main image display -->
          <div class="gallery__main" id="gallery-main">
            {hasImages ? (
              <img
                src={galleryImages[0]}
                alt={product.alt}
                class="gallery__img"
                id="gallery-img"
                loading="eager"
              />
            ) : (
              <div class="gallery__placeholder" aria-label="Costume photo placeholder">
                <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                  <circle cx="12" cy="13" r="4"/>
                </svg>
                <p>Your costume photography here</p>
              </div>
            )}

            <!-- Product badges -->
            <div class="gallery__badges">
              {product.badge && (
                <span class={`img-badge img-badge--${product.badgeType}`}>{product.badge}</span>
              )}
              <span class="img-badge img-badge--cat">{categoryLabel}</span>
            </div>

            <!-- Nav arrows — only shown when >1 image (JS shows/hides) -->
            {hasImages && galleryImages.length > 1 && (
              <>
                <button class="gallery__nav gallery__nav--prev" id="gal-prev" type="button" aria-label="Previous photo">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <button class="gallery__nav gallery__nav--next" id="gal-next" type="button" aria-label="Next photo">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
                <span class="gallery__counter" id="gallery-counter">1 / {galleryImages.length}</span>
              </>
            )}
          </div>

          <!-- Thumbnail strip — up to 5, shown only when images exist -->
          {hasImages && (
            <div class="gallery__thumbs" id="gallery-thumbs" role="list">
              {galleryImages.slice(0, 5).map((img, i) => (
                <button
                  class={`gallery__thumb${i === 0 ? ' gallery__thumb--active' : ''}`}
                  data-index={i}
                  data-src={img}
                  type="button"
                  role="listitem"
                  aria-label={`View photo ${i + 1}`}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  <img src={img} alt={`${product.name} — photo ${i + 1}`} loading="lazy" />
                </button>
              ))}
            </div>
          )}

        </div><!-- /gallery -->

        <!-- Product info -->
        <div class="product-info">
          <h1 class="product-info__title">{product.name}</h1>
          <p class="product-info__desc">{product.description}</p>

          {product.tags && product.tags.length > 0 && (
            <div class="product-info__tags">
              {product.tags.map(tag => (
                <span class="product-tag">{tag}</span>
              ))}
            </div>
          )}

          <!-- PRICE ROW — COMMENTED OUT for Phase 1
          Uncomment when ready to display pricing publicly
          <div class="product-info__price-row">
            <div>
              <span class="product-info__price">{priceDisplay}</span>
              <span class="product-info__per"> /event</span>
            </div>
            <div class="product-info__deposit">
              Deposit: {depositDisplay}
              <span class="product-info__refund">100% refundable</span>
            </div>
          </div>
          -->

          <!-- Hygiene trust signal -->
          <div class="product-info__trust">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Washed &amp; ironed before every rental
          </div>
        </div>

      </div><!-- /detail-left -->

      <!-- RIGHT — Booking panel -->
      <div class="detail-right">
        <div class="booking-panel" id="booking-panel">

          <!-- Panel header -->
          <div class="booking-panel__header">
            <p class="booking-panel__name">{product.name}</p>
            <!-- PRICE IN HEADER — COMMENTED OUT for Phase 1
            <p class="booking-panel__price">
              {priceDisplay}<span class="booking-panel__per"> /event</span>
            </p>
            -->
            <p class="booking-panel__enquire">WhatsApp us for pricing →</p>
          </div>

          <div class="booking-panel__divider"></div>

          <!-- Free Size indicator — auto-selected, no user input needed -->
          <div class="free-size-tag">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Free Size — fits all</span>
          </div>

          <div class="booking-panel__divider"></div>

          <!-- Colour selector — shown only when product has colours defined -->
          {hasColors && (
            <div class="color-selector" id="color-selector">
              <div class="color-selector__header">
                <p class="color-selector__label">Select Colour</p>
                <p class="color-selector__hint" id="color-hint">Please select a colour</p>
              </div>
              <div class="color-selector__chips">
                {productColors.map((color, i) => (
                  <button
                    class="color-chip"
                    data-color={color}
                    type="button"
                    aria-label={`Select colour ${color}`}
                    aria-pressed="false"
                  >
                    {color}
                  </button>
                ))}
              </div>
            </div>
          )}

          {hasColors && <div class="booking-panel__divider"></div>}

          <!-- Date picker -->
          <DatePicker
            price={product.price}
            deposit={product.deposit}
          />

          <div class="booking-panel__divider"></div>

          <!-- PRICE BREAKDOWN — COMMENTED OUT for Phase 1
          Uncomment when ready to show pricing publicly
          <PriceBreakdown
            price={product.price}
            deposit={product.deposit}
          />
          <div class="booking-panel__divider"></div>
          -->

          <!-- WhatsApp booking CTA (no price in message for Phase 1) -->
          <WhatsAppBooking product={product} showPrice={false} categoryLabel={categoryLabel} />

          <!-- Hygiene note -->
          <p class="booking-panel__hygiene">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Washed &amp; ironed before every rental
          </p>

        </div>
      </div>

    </div><!-- /detail-grid -->

    <!-- Related products -->
    {related.length > 0 && (
      <div class="related-section">
        <div class="related-section__inner">
          <h2 class="related-section__title">More in {categoryLabel}</h2>
          <div class="related-grid">
            {related.map(item => (
              <a href={`/catalog/${item.slug}`} class="related-card">
                <div class="related-card__img"></div>
                <div class="related-card__body">
                  <p class="related-card__name">{item.name}</p>
                </div>
              </a>
            ))}
          </div>
          <div class="related-section__link">
            <a href={`/catalog?category=${product.category}`}>View all {categoryLabel.toLowerCase()} →</a>
          </div>
        </div>
      </div>
    )}

  </div>

</Layout>

<!-- Colour selector JS — vanilla -->
<script>
  // @ts-nocheck
  const colorChips = document.querySelectorAll('.color-chip');
  const colorHint  = document.getElementById('color-hint');

  colorChips.forEach(chip => {
    chip.addEventListener('click', () => {
      colorChips.forEach(c => {
        c.classList.remove('color-chip--active');
        c.setAttribute('aria-pressed', 'false');
      });
      chip.classList.add('color-chip--active');
      chip.setAttribute('aria-pressed', 'true');

      const selectedColor = chip.dataset.color;
      if (colorHint) {
        colorHint.textContent = `${selectedColor} selected`;
        colorHint.style.color = '#D4AF37';
      }

      document.dispatchEvent(new CustomEvent('wearit:color-selected', {
        detail: { color: selectedColor }
      }));
    });
  });

  // If no colour chips (product has no colours), auto-fire with null
  if (colorChips.length === 0) {
    // No colour selection needed — will use 'N/A' in message
  }
</script>

<!-- Auto-fire Free Size selection on page load -->
<script>
  // @ts-nocheck
  // All products are Free Size — auto-select immediately so WhatsApp button activates on date selection only
  document.addEventListener('DOMContentLoaded', () => {
    document.dispatchEvent(new CustomEvent('wearit:size-selected', {
      detail: { size: 'Free Size' }
    }));
  });
</script>

<!-- ── Gallery JS (vanilla, no Alpine) ── -->
<script>
  // @ts-nocheck

  // ── State ──
  let currentIndex = 0;
  const galleryImg  = document.getElementById('gallery-img');
  const thumbBtns   = document.querySelectorAll('.gallery__thumb');
  const counterEl   = document.getElementById('gallery-counter');
  const prevBtn     = document.getElementById('gal-prev');
  const nextBtn     = document.getElementById('gal-next');
  const total       = thumbBtns.length;

  if (total === 0) {
    // No images — nothing to wire up
  } else {
    // ── Switch to index ──
    function goTo(index) {
      currentIndex = (index + total) % total;

      // Update main image
      const src = thumbBtns[currentIndex]?.dataset.src;
      if (galleryImg && src) galleryImg.src = src;

      // Update counter
      if (counterEl) counterEl.textContent = `${currentIndex + 1} / ${total}`;

      // Update thumbnail active states
      thumbBtns.forEach((btn, i) => {
        btn.classList.toggle('gallery__thumb--active', i === currentIndex);
        btn.setAttribute('aria-pressed', i === currentIndex ? 'true' : 'false');
      });
    }

    // ── Thumbnail clicks ──
    thumbBtns.forEach(btn => {
      btn.addEventListener('click', () => goTo(parseInt(btn.dataset.index, 10)));
    });

    // ── Arrow navigation ──
    prevBtn?.addEventListener('click', () => goTo(currentIndex - 1));
    nextBtn?.addEventListener('click', () => goTo(currentIndex + 1));

    // ── Touch swipe (mobile) ──
    const galleryMain = document.getElementById('gallery-main');
    let touchStartX = 0;

    galleryMain?.addEventListener('touchstart', e => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    galleryMain?.addEventListener('touchend', e => {
      const diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 50) {
        goTo(diff > 0 ? currentIndex + 1 : currentIndex - 1);
      }
    }, { passive: true });

    // ── Keyboard navigation ──
    document.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft')  goTo(currentIndex - 1);
      if (e.key === 'ArrowRight') goTo(currentIndex + 1);
    });
  }
</script>

<style>


  /* Colour selector */
  .color-selector { display: flex; flex-direction: column; gap: 0.625rem; }
  .color-selector__header { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .color-selector__label { font-size: 0.875rem; font-weight: 600; color: #2A1124; margin: 0; }
  .color-selector__hint { font-size: 0.75rem; color: rgba(42,17,36,0.4); margin: 0; transition: color 0.15s; }
  .color-selector__chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .color-chip {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #2A1124;
    background: #fff;
    border: 1.5px solid rgba(42,17,36,0.15);
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.15s;
    min-height: 44px;
    font-family: inherit;
    outline: none;
  }

  .color-chip:hover { border-color: #D4AF37; color: #D4AF37; }
