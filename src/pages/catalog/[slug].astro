  .booking-panel { background: #fff; border: 0.5px solid rgba(42,17,36,0.1); border-radius: 1.125rem; padding: 1.5rem; display: flex; flex-direction: column; gap: 1.125rem; box-shadow: 0 4px 24px rgba(42,17,36,0.07); }

