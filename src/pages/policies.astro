---

<Layout
  title="Policies & FAQ — wearit Costume Rentals, Hinjewadi Pune"
  description="wearit rental policies: security deposit, cancellation, damage, late return, business hours & FAQ. Transparent, fair, and no hidden terms. Serving Hinjewadi, Wakad & Baner, Pune."
>

  <div class="policies-page">

    <!-- ── Page Header ── -->
    <div class="page-header">
      <div class="page-header__inner">
        <a href="/" class="back-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
          Back to home
        </a>
        <h1 class="page-header__title">Policies &amp; FAQ</h1>
        <p class="page-header__sub">Everything you need to know before booking</p>
      </div>
    </div>

    <div class="page-inner">

      <!-- ── Policy Cards ── -->
      <section aria-labelledby="policies-title">
        <h2 class="section-title" id="policies-title">Our Policies</h2>
        <p class="section-sub">Clear, fair, and no hidden terms.</p>

        <div class="policy-grid">
          {policies.map(p => (
            <div class="policy-card">
              <div class="policy-card__icon" style={`color: ${p.color}`}>
                <Fragment set:html={p.icon} />
              </div>
              <h3 class="policy-card__title">{p.title}</h3>
              <p class="policy-card__content">{p.content}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ── FAQ Accordion ── -->
      <section class="faq-section" aria-labelledby="faq-title">
        <h2 class="section-title" id="faq-title">Frequently Asked Questions</h2>
        <p class="section-sub">Can't find your answer? <a href={waLink} target="_blank" rel="noopener noreferrer" class="inline-link">WhatsApp us directly →</a></p>

        <div class="faq-list" id="faq-list">
          {faqs.map((faq, i) => (
            <div class="faq-item" id={`faq-${i}`}>
              <button
                class="faq-btn"
                type="button"
                aria-expanded="false"
                aria-controls={`faq-answer-${i}`}
                data-faq-btn
              >
                <span class="faq-btn__text">{faq.q}</span>
                <span class="faq-btn__icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </span>
              </button>
              <div
                class="faq-answer"
                id={`faq-answer-${i}`}
                role="region"
                aria-labelledby={`faq-${i}`}
                hidden
              >
                <p class="faq-answer__text">{faq.a}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ── Still have questions? ── -->
      <div class="cta-strip">
        <div class="cta-strip__content">
          <p class="cta-strip__title">Still have a question?</p>
          <p class="cta-strip__sub">We reply on WhatsApp within 30 minutes, Mon–Sat 10am–8pm.</p>
        </div>
        <a
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-strip__btn"
          aria-label="Chat with wearit on WhatsApp"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/>
          </svg>
          Chat on WhatsApp
        </a>
      </div>

    </div>
  </div>

</Layout>

<!-- Vanilla JS FAQ accordion -->
<script>
  // @ts-nocheck
  const faqBtns = document.querySelectorAll('[data-faq-btn]');

  faqBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const isOpen    = btn.getAttribute('aria-expanded') === 'true';
      const answerId  = btn.getAttribute('aria-controls');
      const answerEl  = document.getElementById(answerId);

      // Close all others
      faqBtns.forEach(b => {
        b.setAttribute('aria-expanded', 'false');
        b.classList.remove('faq-btn--open');
        const id = b.getAttribute('aria-controls');
        const el = document.getElementById(id);
        if (el) el.hidden = true;
      });

      // Toggle clicked
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        btn.classList.add('faq-btn--open');
        if (answerEl) answerEl.hidden = false;
      }
    });
  });
</script>

<style>
