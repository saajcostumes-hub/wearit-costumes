---
// @ts-nocheck
// Footer.astro — Royal Palette update

import { BUSINESS } from "../../lib/constants.js";

const year         = new Date().getFullYear();
const waLink       = `https://wa.me/${BUSINESS.whatsapp.waMeNumber}`;
const phoneDisplay = BUSINESS.whatsapp.display;
const telLink      = `tel:+${String(BUSINESS.whatsapp.waMeNumber).replace(/\D/g, '')}`;
---

<footer style="background-color: #2A1124; color: white; margin-top: auto;">

  <!-- 3-column grid -->
  <div class="container-x py-12 grid grid-cols-1 md:grid-cols-3 gap-10">

    <!-- Column 1: Brand block -->
    <div class="flex flex-col gap-3">
      <a href="/" class="font-display text-2xl font-semibold tracking-tight w-fit">
        <span style="color: #FAF8F5;">wear</span><span style="color: #D4AF37;">it</span>
      </a>
      <p style="color: rgba(250,248,245,0.55); font-size: 0.875rem; line-height: 1.6;">
        Premium costume rentals — washed, ironed &amp; festival-ready.<br />
        Serving Hinjewadi, Wakad, Baner &amp; Balewadi.
      </p>
      <a href={waLink} target="_blank" rel="noopener noreferrer"
         style="color: #25D366; font-size: 0.875rem; font-weight: 500;">
        💬 Chat on WhatsApp
      </a>
    </div>

    <!-- Column 2: Service areas -->
    <div class="flex flex-col gap-3">
      <h3 style="color: rgba(212,175,55,0.55); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;">
        Service Areas
      </h3>
      <ul class="flex flex-col gap-1.5">
        {BUSINESS.serviceAreas.map((area) => (
          <li style="color: rgba(250,248,245,0.5); font-size: 0.875rem;">{area}</li>
        ))}
      </ul>
    </div>

    <!-- Column 3: Hours + pickup -->
    <div class="flex flex-col gap-3">
      <h3 style="color: rgba(212,175,55,0.55); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;">
        Hours &amp; Pickup
      </h3>
      <ul class="flex flex-col gap-1.5" style="color: rgba(250,248,245,0.5); font-size: 0.875rem;">
        <li>{BUSINESS.hours.weekdays.label} · {BUSINESS.hours.weekdays.open} – {BUSINESS.hours.weekdays.close}</li>
        <li>{BUSINESS.hours.sunday.label} · {BUSINESS.hours.sunday.note}</li>
      </ul>
      <div class="flex flex-col gap-1 mt-2" style="color: rgba(250,248,245,0.5); font-size: 0.875rem;">
        <span>📍 {BUSINESS.pickupLocation.area}, {BUSINESS.pickupLocation.city} {BUSINESS.pickupLocation.pin}</span>
        <a href={waLink} target="_blank" rel="noopener noreferrer"
           style="color: rgba(250,248,245,0.5);">
          📱 {BUSINESS.whatsapp.display}
        </a>
      </div>
    </div>

  </div>

  <!-- Contact Strip -->
  <div style="border-top: 1px solid rgba(212,175,55,0.15);">
    <div class="container-x" style="padding-top: 1.5rem; padding-bottom: 1.5rem;">

      <p style="font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(212,175,55,0.45); margin-bottom: 0.75rem; font-weight: 500;">
        Get in touch
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3" style="max-width: 560px;">

        <!-- WhatsApp card -->
        <a href={waLink} target="_blank" rel="noopener noreferrer" class="contact-card">
          <div class="contact-card__icon contact-card__icon--wa">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="white" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/>
            </svg>
          </div>
          <div>
            <p class="contact-card__label">WhatsApp</p>
            <p class="contact-card__number">{phoneDisplay}</p>
          </div>
        </a>

        <!-- Call card -->
        <a href={telLink} class="contact-card">
          <div class="contact-card__icon contact-card__icon--call">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.45 2 2 0 0 1 3.59 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.29 6.29l1.12-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div>
            <p class="contact-card__label">Call us</p>
            <p class="contact-card__number">{phoneDisplay}</p>
          </div>
        </a>

      </div>

      <p style="font-size: 0.6875rem; color: rgba(212,175,55,0.35); margin-top: 0.75rem;">
        Mon – Sat &nbsp;·&nbsp; 10am – 8pm
      </p>

    </div>
  </div>

  <!-- Bottom bar -->
  <div style="border-top: 1px solid rgba(212,175,55,0.1);">
    <div class="container-x py-4 flex flex-col md:flex-row items-center justify-between gap-2"
         style="font-size: 0.75rem; color: rgba(212,175,55,0.35);">
      <span>© {year} {BUSINESS.legalName}. All rights reserved.</span>
      <div class="flex items-center gap-4">
        <a href="/policies" style="color: rgba(212,175,55,0.35);">Policies</a>
        <a href="/faq"      style="color: rgba(212,175,55,0.35);">FAQ</a>
        <a href="/contact"  style="color: rgba(212,175,55,0.35);">Contact</a>
      </div>
    </div>
  </div>

</footer>

<style>
  .contact-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 0.75rem;
    background: rgba(212, 175, 55, 0.06);
    border: 0.5px solid rgba(212, 175, 55, 0.15);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .contact-card:hover { background: rgba(212, 175, 55, 0.1); }

  .contact-card__icon {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contact-card__icon--wa   { background: #25D366; }
  .contact-card__icon--call { background: rgba(212, 175, 55, 0.25); }

  .contact-card__label {
    font-size: 0.6875rem;
    color: rgba(212, 175, 55, 0.4);
    margin-bottom: 0.125rem;
  }

  .contact-card__number {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #FAF8F5;
  }
</style>