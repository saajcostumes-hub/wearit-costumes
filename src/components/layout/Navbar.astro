---
// @ts-nocheck
// Navbar.astro — Royal Palette update
// Removed Alpine.js mobile menu → vanilla JS (consistent with project)

import { BUSINESS } from '../../lib/constants.js';

const navLinks = [
  { label: "Home",     href: "/" },
  { label: "Catalog",  href: "/catalog" },
  { label: "Policies", href: "/policies" },
  { label: "About",    href: "/about" },
];

const currentPath = Astro.url.pathname;
const waIntroMsg = encodeURIComponent("Hi wearit! I'd like to know more about your costume rentals.");
const waLink     = `https://wa.me/${BUSINESS.whatsapp.waMeNumber}?text=${waIntroMsg}`;
---

<header class="sticky top-0 z-50" style="background: #2A1124; border-bottom: 0.5px solid rgba(212,175,55,0.15);">
  <div class="container-x flex items-center justify-between h-16">

    <!-- Wordmark -->
    <a href="/" class="font-display text-2xl font-semibold tracking-tight hover:opacity-80 transition-opacity">
      <span style="color: #FAF8F5;">wear</span><span style="color: #D4AF37;">it</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          style={currentPath === link.href
            ? 'color: #D4AF37; font-weight: 600; border-bottom: 2px solid #D4AF37; padding-bottom: 2px; font-size: 0.875rem; text-decoration: none;'
            : 'color: rgba(250,248,245,0.55); font-size: 0.875rem; text-decoration: none; transition: color 0.15s;'}
          onmouseover={currentPath !== link.href ? "this.style.color='#D4AF37'" : ""}
          onmouseout={currentPath !== link.href ? "this.style.color='rgba(250,248,245,0.55)'" : ""}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop Book Now -->
    <a
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden md:inline-flex items-center gap-2 text-sm font-semibold px-4 py-2 rounded-md"
      style="background: #D4AF37; color: #2A1124; border-radius: 6px; text-decoration: none;"
    >
      Book Now
    </a>

    <!-- Hamburger — mobile only -->
    <button
      id="nav-hamburger"
      class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5 rounded-md transition-colors"
      style="background: transparent;"
      aria-label="Toggle menu"
      aria-expanded="false"
      type="button"
    >
      <span class="hamburger-line" style="display:block; width:20px; height:2px; background:#FAF8F5; transition: all 0.3s; transform-origin: center;"></span>
      <span class="hamburger-line" style="display:block; width:20px; height:2px; background:#FAF8F5; transition: all 0.3s;"></span>
      <span class="hamburger-line" style="display:block; width:20px; height:2px; background:#FAF8F5; transition: all 0.3s; transform-origin: center;"></span>
    </button>

  </div>

  <!-- Mobile menu panel -->
  <nav
    id="mobile-menu"
    class="md:hidden"
    style="display: none; border-top: 0.5px solid rgba(212,175,55,0.15); background: #2A1124;"
    aria-label="Mobile navigation"
  >
    <div class="container-x py-3 flex flex-col gap-1">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="mobile-nav-link"
          style={currentPath === link.href
            ? 'display:block; padding: 10px 16px; font-size:0.875rem; font-weight:600; border-radius:6px; background: rgba(212,175,55,0.1); color: #D4AF37; text-decoration:none;'
            : 'display:block; padding: 10px 16px; font-size:0.875rem; color: rgba(250,248,245,0.6); border-radius:6px; text-decoration:none;'}
        >
          {link.label}
        </a>
      ))}

      <!-- WhatsApp CTA in mobile menu -->
      <div style="margin-top: 8px; padding-top: 12px; border-top: 0.5px solid rgba(212,175,55,0.12);">
        <a
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          style="display:flex; align-items:center; justify-content:center; gap:8px; background:#D4AF37; color:#2A1124; font-weight:700; font-size:0.875rem; padding:10px 16px; border-radius:6px; text-decoration:none;"
        >
          Book via WhatsApp
        </a>
      </div>
    </div>
  </nav>
</header>

<!-- Vanilla JS mobile menu toggle — no Alpine needed -->
<script>
  // @ts-nocheck
  const hamburger  = document.getElementById('nav-hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  const lines      = document.querySelectorAll('.hamburger-line');

  hamburger?.addEventListener('click', () => {
    const isOpen = mobileMenu.style.display === 'block';

    mobileMenu.style.display = isOpen ? 'none' : 'block';
    hamburger.setAttribute('aria-expanded', isOpen ? 'false' : 'true');

    // Animate hamburger to X
    if (!isOpen) {
      lines[0].style.transform = 'rotate(45deg) translate(5px, 5px)';
      lines[1].style.opacity   = '0';
      lines[2].style.transform = 'rotate(-45deg) translate(5px, -5px)';
    } else {
      lines[0].style.transform = '';
      lines[1].style.opacity   = '1';
      lines[2].style.transform = '';
    }
  });

  // Close menu when a link is tapped
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.style.display = 'none';
      lines[0].style.transform = '';
      lines[1].style.opacity   = '1';
      lines[2].style.transform = '';
    });
  });
</script>