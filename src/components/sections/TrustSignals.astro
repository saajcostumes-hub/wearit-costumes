---
// TrustSignals.astro — Sprint 1 · S5
// ─────────────────────────────────────────────
// "Why families trust wearit" — 2×2 card grid
// NO UV Sanitization mention — replaced with "Washed & Ironed"
// Testimonial placeholder slot below cards
// Fully static — no Alpine, no JS
// ─────────────────────────────────────────────

const trustCards = [
  {
    id:    'hygiene',
    icon:  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
            </svg>`,
    color:    '#E85D26',
    title:    'Washed & Ironed',
    desc:     'Every costume freshly cleaned and pressed before handover — guaranteed.',
  },
  {
    id:    'deposit',
    icon:  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>`,
    color:    '#C9A84C',
    title:    '100% Refundable',
    desc:     'Full security deposit returned the same day you return the costume.',
  },
  {
    id:    'local',
    icon:  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>`,
    color:    '#E85D26',
    title:    'Locally Based',
    desc:     'Based in Maan, Hinjewadi — serving Wakad, Baner & Balewadi.',
  },
  {
    id:    'response',
    icon:  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>`,
    color:    '#25D366',
    title:    '30-min Response',
    desc:     'WhatsApp support Mon–Sat, 10am–8pm. We reply fast, always.',
  },
];
---

<section class="trust" aria-labelledby="trust-title">

  <div class="trust__inner">

    <!-- Section header -->
    <div class="trust__header">
      <h2 class="trust__title" id="trust-title">Why families trust wearit</h2>
      <p class="trust__sub">Clean, fair, and always on time</p>
    </div>

    <!-- 2×2 card grid -->
    <div class="trust__grid">
      {trustCards.map(card => (
        <div class="trust-card">

          <!-- Icon -->
          <div class="trust-card__icon" style={`color: ${card.color}`}>
            <Fragment set:html={card.icon} />
          </div>

          <!-- Text -->
          <h3 class="trust-card__title">{card.title}</h3>
          <p class="trust-card__desc">{card.desc}</p>

        </div>
      ))}
    </div>

    <!-- Testimonial placeholder -->
    <div class="testimonial-slot" aria-label="Customer testimonials coming soon">
      <svg class="testimonial-slot__quote" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
      </svg>
      <p class="testimonial-slot__text">
        "Be our first happy customer!"
      </p>
      <p class="testimonial-slot__hint">
        Testimonials appear here as reviews come in
      </p>
    </div>

  </div>

</section>

<style>
  /* ═══════════════════════════════════════════
     SECTION
  ═══════════════════════════════════════════ */
  .trust {
    background-color: #FDF6EE;
    padding: 2.5rem 0;
    border-top: 0.5px solid rgba(26, 26, 46, 0.07);
  }

  .trust__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 768px) {
    .trust__inner { padding-inline: 3rem; }
  }

  /* ═══════════════════════════════════════════
     HEADER
  ═══════════════════════════════════════════ */
  .trust__header { margin-bottom: 1.25rem; }

  .trust__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    color: #1A1A2E;
    margin-bottom: 0.25rem;
  }

  .trust__sub {
    font-size: 0.8125rem;
    color: rgba(26, 26, 46, 0.42);
  }

  /* ═══════════════════════════════════════════
     2×2 CARD GRID
  ═══════════════════════════════════════════ */
  .trust__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .trust__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
  }

  /* ═══════════════════════════════════════════
     TRUST CARD
  ═══════════════════════════════════════════ */
  .trust-card {
    background: #fff;
    border: 0.5px solid rgba(26, 26, 46, 0.08);
    border-radius: 0.875rem;
    padding: 1rem 0.875rem;
    box-shadow: 0 1px 4px rgba(26, 26, 46, 0.05);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  @media (min-width: 768px) {
    .trust-card {
      border-radius: 1.125rem;
      padding: 1.25rem 1rem;
      gap: 0.5rem;
    }
  }

  /* ── Icon ── */
  .trust-card__icon {
    display: flex;
    align-items: center;
    margin-bottom: 0.25rem;
  }

  /* ── Title ── */
  .trust-card__title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #1A1A2E;
    line-height: 1.3;
  }

  @media (min-width: 768px) {
    .trust-card__title { font-size: 0.9375rem; }
  }

  /* ── Description ── */
  .trust-card__desc {
    font-size: 0.625rem;
    color: rgba(26, 26, 46, 0.45);
    line-height: 1.55;
  }

  @media (min-width: 768px) {
    .trust-card__desc { font-size: 0.75rem; }
  }

  /* ═══════════════════════════════════════════
     TESTIMONIAL PLACEHOLDER SLOT
  ═══════════════════════════════════════════ */
  .testimonial-slot {
    background: rgba(26, 26, 46, 0.03);
    border: 0.5px dashed rgba(26, 26, 46, 0.12);
    border-radius: 0.875rem;
    padding: 1.25rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
  }

  .testimonial-slot__quote {
    width: 1.25rem;
    height: 1.25rem;
    color: rgba(26, 26, 46, 0.15);
    margin-bottom: 0.125rem;
  }

  .testimonial-slot__text {
    font-size: 0.875rem;
    color: rgba(26, 26, 46, 0.3);
    font-style: italic;
  }

  .testimonial-slot__hint {
    font-size: 0.6875rem;
    color: rgba(26, 26, 46, 0.2);
  }
</style>