---
// @ts-nocheck
// PopularThisSeason.astro — Sprint 2 · Step 9 update
// Now uses ProductCard.astro — consistent cards with View Details links
// featuredProducts from products.js (featured: true items only)

import ProductCard       from '../catalog/ProductCard.astro';
import { featuredProducts } from '../../data/products.js';
---

<section class="popular" aria-labelledby="popular-title">
  <div class="popular__inner">

    <div class="popular__header">
      <h2 class="popular__title" id="popular-title">Popular this season</h2>
      <p class="popular__sub">Our most booked costumes right now</p>
    </div>

    <div class="popular__grid">
      {featuredProducts.map(product => (
        <ProductCard product={product} showCategory={true} />
      ))}
    </div>

    <div class="popular__footer">
      <a href="/catalog" class="popular__view-all">
        View full collection
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  .popular {
    background-color: #FAF8F5;
    padding: 2.5rem 0;
    border-top: 0.5px solid rgba(42, 17, 36, 0.07);
  }

  .popular__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 768px) {
    .popular__inner { padding-inline: 3rem; }
  }

  .popular__header { margin-bottom: 1.25rem; }

  .popular__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    color: #2A1124;
    margin-bottom: 0.25rem;
  }

  .popular__sub {
    font-size: 0.8125rem;
    color: rgba(42, 17, 36, 0.42);
  }

  .popular__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .popular__grid {
      grid-template-columns: repeat(2, minmax(0, 360px));
      gap: 1.25rem;
    }
  }

  .popular__footer { text-align: center; }

  .popular__view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #D4AF37;
    text-decoration: none;
    transition: gap 0.15s ease;
  }

  .popular__view-all:hover { gap: 0.625rem; }
</style>