---
// HowItWorks.astro — Sprint 1 · S2
// ─────────────────────────────────────────────
// Option C: 3 equal bold tiles side by side
// Ghost numbers behind each tile (opacity ~6%)
// Step 3 says "Pickup from Maan" — no delivery mention
// No Alpine.js — fully static
// ─────────────────────────────────────────────

const steps = [
  {
    num:   '1',
    color: '#E85D26',
    title: 'Browse & choose',
    desc:  'Pick a costume and rental dates from the catalog',
    icon:  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2"/>
              <path d="M8 21h8M12 17v4"/>
            </svg>`,
  },
  {
    num:   '2',
    color: '#25D366',
    title: 'Book via WhatsApp',
    desc:  'One tap sends your booking — we confirm in 30 mins',
    icon:  `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/>
            </svg>`,
  },
  {
    num:   '3',
    color: '#C9A84C',
    title: 'Pickup & celebrate',
    desc:  'Collect at Maan. Enjoy your event. Return & deposit back.',
    icon:  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>`,
  },
];
---

<section class="hiw" aria-labelledby="hiw-title">

  <div class="hiw__inner">

    <!-- Section header -->
    <div class="hiw__header">
      <h2 class="hiw__title" id="hiw-title">How it works</h2>
      <p class="hiw__sub">Browse. Book. Celebrate.</p>
    </div>

    <!-- 3 tiles -->
    <div class="hiw__tiles" role="list">
      {steps.map(step => (
        <div class="hiw__tile" role="listitem">

          <!-- Ghost number (decorative background) -->
          <span class="hiw__ghost" style={`color: ${step.color}`} aria-hidden="true">
            {step.num}
          </span>

          <!-- Icon -->
          <div class="hiw__icon" style={`color: ${step.color}`}>
            <Fragment set:html={step.icon} />
          </div>

          <!-- Text -->
          <p class="hiw__step-title">{step.title}</p>
          <p class="hiw__step-desc">{step.desc}</p>

        </div>
      ))}
    </div>

  </div>

</section>

<style>
  /* ═══════════════════════════════════════════
     SECTION
  ═══════════════════════════════════════════ */
  .hiw {
    background-color: #FDF6EE;
    padding: 2.5rem 0;
    border-top: 0.5px solid rgba(26, 26, 46, 0.07);
  }

  .hiw__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 768px) {
    .hiw__inner {
      padding-inline: 3rem;
    }
  }

  /* ═══════════════════════════════════════════
     HEADER
  ═══════════════════════════════════════════ */
  .hiw__header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .hiw__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    color: #1A1A2E;
    margin-bottom: 0.25rem;
  }

  .hiw__sub {
    font-size: 0.8125rem;
    color: rgba(26, 26, 46, 0.42);
  }

  /* ═══════════════════════════════════════════
     TILES ROW — 3 equal columns
  ═══════════════════════════════════════════ */
  .hiw__tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.625rem;
  }

  @media (min-width: 768px) {
    .hiw__tiles {
      gap: 1.25rem;
    }
  }

  /* ═══════════════════════════════════════════
     INDIVIDUAL TILE
  ═══════════════════════════════════════════ */
  .hiw__tile {
    background: #fff;
    border: 0.5px solid rgba(26, 26, 46, 0.07);
    border-radius: 0.875rem;
    padding: 1rem 0.75rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(26, 26, 46, 0.05);
  }

  @media (min-width: 768px) {
    .hiw__tile {
      padding: 1.75rem 1.25rem;
      border-radius: 1.25rem;
    }
  }

  /* ── Ghost number (behind content) ── */
  .hiw__ghost {
    position: absolute;
    top: -0.5rem;
    right: 0.25rem;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1;
    opacity: 0.06;
    pointer-events: none;
    user-select: none;
  }

  @media (min-width: 768px) {
    .hiw__ghost { font-size: 5rem; }
  }

  /* ── Icon ── */
  .hiw__icon {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.625rem;
  }

  .hiw__icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  @media (min-width: 768px) {
    .hiw__icon svg {
      width: 2rem;
      height: 2rem;
    }
  }

  /* ── Step title ── */
  .hiw__step-title {
    position: relative;
    z-index: 1;
    font-size: 0.6875rem;
    font-weight: 600;
    color: #1A1A2E;
    margin-bottom: 0.375rem;
    line-height: 1.3;
  }

  @media (min-width: 768px) {
    .hiw__step-title { font-size: 0.875rem; }
  }

  /* ── Step description ── */
  .hiw__step-desc {
    position: relative;
    z-index: 1;
    font-size: 0.625rem;
    color: rgba(26, 26, 46, 0.42);
    line-height: 1.45;
  }

  @media (min-width: 768px) {
    .hiw__step-desc { font-size: 0.75rem; }
  }
</style>