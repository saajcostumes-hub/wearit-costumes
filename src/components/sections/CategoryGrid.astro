---
// CategoryGrid.astro — Sprint 1 · S4
// ─────────────────────────────────────────────
// Tab switching via vanilla JS <script> — no Alpine dependency
// Women's panel visible by default, others hidden via inline style
// Astro hoists <script> tags — runs after DOM is ready
// ─────────────────────────────────────────────

import { categoryTabs } from '../../data/categories.js';

const defaultTabId = categoryTabs.find(t => t.isDefault)?.id ?? categoryTabs[0].id;
---

<section class="catgrid" aria-labelledby="catgrid-title">

  <div class="catgrid__inner">
    <div class="catgrid__header">
      <h2 class="catgrid__title" id="catgrid-title">Browse by costume</h2>
      <p class="catgrid__sub">Tap any category to explore</p>
    </div>
  </div>

  <!-- Tab nav -->
  <div class="catgrid__tabs" role="tablist" aria-label="Costume categories">
    {categoryTabs.map(tab => (
      <button
        class={`catgrid__tab${tab.id === defaultTabId ? ' catgrid__tab--active' : ''}`}
        data-tab={tab.id}
        role="tab"
        aria-selected={tab.id === defaultTabId ? 'true' : 'false'}
        aria-controls={`panel-${tab.id}`}
        type="button"
      >
        {tab.label}
      </button>
    ))}
  </div>

  <!-- Tab panels: default panel visible, others hidden via inline style -->
  {categoryTabs.map(tab => (
    <div
      id={`panel-${tab.id}`}
      role="tabpanel"
      class="catgrid__panel"
      style={tab.id === defaultTabId ? '' : 'display: none'}
    >
      <div class="catgrid__inner catgrid__panel-inner">

        <div class="catgrid__grid">
          {tab.items.map(item => (
            <a
              href={`/catalog/${item.slug}`}
              class="cat-card"
              aria-label={`Browse ${item.name}`}
            >
              <div class="cat-card__img">
                <svg class="cat-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              </div>
              <div class="cat-card__body">
                <p class="cat-card__name">{item.name}</p>
                <p class="cat-card__sub">{item.sub}</p>
                <span class={`cat-card__badge cat-card__badge--${item.badgeType}`}>
                  {item.badge}
                </span>
              </div>
            </a>
          ))}
        </div>

        <div class="catgrid__footer">
          <a href={`/catalog?category=${tab.id}`} class="catgrid__view-all">
            View all {tab.label.toLowerCase()} costumes
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

      </div>
    </div>
  ))}

</section>

<!-- Vanilla JS tab switching — no Alpine needed -->
<script>
  // @ts-nocheck — JS-only project, TS type narrowing not needed here
  const tabs   = document.querySelectorAll('.catgrid__tab');
  const panels = document.querySelectorAll('.catgrid__panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab;

      // Update tab active states
      tabs.forEach(t => {
        t.classList.remove('catgrid__tab--active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('catgrid__tab--active');
      tab.setAttribute('aria-selected', 'true');

      // Show selected panel, hide others
      panels.forEach(panel => {
        panel.style.display = panel.id === `panel-${target}` ? '' : 'none';
      });
    });
  });
</script>

<style>
  .catgrid {
    background-color: #FAF8F5;
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
    border-top: 0.5px solid rgba(42, 17, 36, 0.07);
  }

  .catgrid__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 768px) {
    .catgrid__inner { padding-inline: 3rem; }
  }

  .catgrid__header { margin-bottom: 1rem; }

  .catgrid__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    color: #2A1124;
    margin-bottom: 0.25rem;
  }

  .catgrid__sub {
    font-size: 0.8125rem;
    color: rgba(42, 17, 36, 0.42);
  }

  /* ── Tab nav ── */
  .catgrid__tabs {
    display: flex;
    border-bottom: 0.5px solid rgba(42, 17, 36, 0.08);
    padding-inline: 1.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    gap: 0;
    max-width: 1200px;
    margin-inline: auto;
    width: 100%;
  }

  .catgrid__tabs::-webkit-scrollbar { display: none; }

  @media (min-width: 768px) {
    .catgrid__tabs { padding-inline: 3rem; }
  }

  /* ── Tab button — reset browser defaults ── */
  .catgrid__tab {
    padding: 0.625rem 1.125rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(42, 17, 36, 0.38);
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0;             /* kill browser button rounding */
    background: transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.15s ease, border-color 0.15s ease;
    min-height: 44px;
    margin-bottom: -1px;
    outline: none;                /* remove yellow focus ring */
    -webkit-appearance: none;
    appearance: none;
    font-family: inherit;
  }

  .catgrid__tab:focus-visible {
    outline: 2px solid #D4AF37;
    outline-offset: -2px;
  }

  .catgrid__tab:hover {
    color: rgba(42, 17, 36, 0.65);
  }

  /* JS adds this class on click */
  .catgrid__tab--active {
    color: #D4AF37;
    border-bottom-color: #D4AF37;
    font-weight: 600;
  }

  /* ── Panel ── */
  .catgrid__panel-inner { padding-top: 1.125rem; }

  /* ── Card grid — 2 col mobile, 4 col desktop ── */
  .catgrid__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.625rem;
    margin-bottom: 1.125rem;
  }

  @media (min-width: 768px) {
    .catgrid__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
  }

  /* ── Category card ── */
  .cat-card {
    background: #fff;
    border: 0.5px solid rgba(42, 17, 36, 0.08);
    border-radius: 0.875rem;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    box-shadow: 0 1px 4px rgba(42, 17, 36, 0.05);
    transition: box-shadow 0.2s ease, transform 0.15s ease;
  }

  .cat-card:hover {
    box-shadow: 0 4px 16px rgba(42, 17, 36, 0.1);
    transform: translateY(-2px);
  }

  @media (min-width: 768px) { .cat-card { border-radius: 1.125rem; } }

  .cat-card__img {
    background: linear-gradient(145deg, #FDF0E6, #F8E6D4);
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 0.5px solid rgba(212, 175, 55, 0.08);
  }

  @media (min-width: 768px) { .cat-card__img { height: 5rem; } }

  .cat-card__icon {
    width: 1.625rem;
    height: 1.625rem;
    color: rgba(212, 175, 55, 0.4);
  }

  .cat-card__body {
    padding: 0.625rem 0.75rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
  }

  @media (min-width: 768px) { .cat-card__body { padding: 0.875rem 1rem 1rem; } }

  .cat-card__name {
    font-size: 0.75rem;
    font-weight: 600;
    color: #2A1124;
    line-height: 1.3;
  }

  @media (min-width: 768px) { .cat-card__name { font-size: 0.875rem; } }

  .cat-card__sub {
    font-size: 0.625rem;
    color: rgba(42, 17, 36, 0.42);
    line-height: 1.4;
  }

  .cat-card__badge {
    display: inline-block;
    font-size: 0.5625rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    margin-top: 0.3rem;
    width: fit-content;
  }

  .cat-card__badge--exclusive {
    background: rgba(212, 175, 55, 0.1);
    color: #D4AF37;
  }

  .cat-card__badge--price {
    background: rgba(201, 168, 76, 0.12);
    color: #D4AF37;
  }

  /* ── View all link ── */
  .catgrid__footer { text-align: center; padding-top: 0.25rem; }

  .catgrid__view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #D4AF37;
    text-decoration: none;
    transition: gap 0.15s ease;
  }

  .catgrid__view-all:hover { gap: 0.625rem; }
</style>