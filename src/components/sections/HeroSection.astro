---
// @ts-nocheck
// HeroSection.astro — Sprint 4 update (carousel added)
// Vanilla JS chips + 4-slide auto-carousel

import { heroChips } from '../../data/categories.js';

const defaultChip  = heroChips[0];
const defaultHref  = `/catalog?category=${defaultChip.categoryId}`;
const defaultLabel = `${defaultChip.btnLabel} →`;

const chips = heroChips.map(chip => ({
  id:        chip.id,
  label:     chip.label,
  btnLabel:  chip.btnLabel,
  href:      `/catalog?category=${chip.categoryId}`,
  chipClass: chip.isWomens ? 'chip chip--womens' : 'chip chip--default',
  isFirst:   chip.id === defaultChip.id,
}));

// Carousel slides — updated labels to match new category names
const carouselSlides = [
  { label: 'Paithani Nauwari Kashta', tag: 'Most Booked',       image: '/images/nauwari-saree-1.jpg',  href: '/catalog?category=nauwari' },
  { label: 'Velvet Nauwari Kashta',   tag: 'Only in wearit',    image: '/images/kashta-saree-1.jpeg',  href: '/catalog?category=velvet'  },
  { label: 'Designer Nauwari Kashta', tag: 'Premium Collection', image: '/images/kashta-saree-4.jpeg', href: '/catalog?category=kashtha' },
  { label: 'Paithani Nauwari Kashta', tag: 'Festival Ready',    image: '/images/nauwari-saree-3.jpg',  href: '/catalog?category=nauwari' },
];
---

<section class="hero" aria-label="Hero section">
  <div class="hero__inner">

    <!-- LEFT: Text + Chips -->
    <div class="hero__content">

      <div class="festival-badge">
        <span class="festival-badge__dot" aria-hidden="true"></span>
        <span>Ganesh Chaturthi 2026 — Pre-Book Now</span>
      </div>

      <h1 class="hero__headline">
        Premium Costume Rentals in
        <span class="hero__headline-location">Hinjewadi · Wakad · Baner</span>
      </h1>

      <p class="hero__subline">Festival-Ready Costumes · Washed &amp; Ironed · WhatsApp Booking</p>

      <!-- Carousel — MOBILE only -->
      <div class="hero__carousel hero__carousel--mobile" aria-label="Featured categories">
        <div class="carousel__track">
          {carouselSlides.map((slide, i) => (
            <a
              href={slide.href}
              class={`carousel__slide${i === 0 ? ' carousel__slide--active' : ''}`}
              style="background: #2A1124;"
              aria-label={`Browse ${slide.label}`}
            >
              {slide.image && (
                <img
                  src={slide.image}
                  alt={slide.label}
                  class="carousel__slide-img"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              )}
              <div class="carousel__slide-overlay">
                <span class="stage__tag">
                  <svg width="9" height="9" viewBox="0 0 12 12" fill="#D4AF37" aria-hidden="true"><path d="M6 1l1.545 3.09L11 4.618l-2.5 2.427.59 3.42L6 8.817l-3.09 1.648.59-3.42L1 4.618z"/></svg>
                  {slide.tag}
                </span>
                <span class="carousel__label">{slide.label}</span>
              </div>
            </a>
          ))}
        </div>
        <div class="carousel__dots">
          {carouselSlides.map((_, i) => (
            <button class={`carousel__dot${i === 0 ? ' carousel__dot--active' : ''}`} data-slide={i} type="button" aria-label={`Slide ${i + 1}`}></button>
          ))}
        </div>
      </div>

      <p class="chip-label" aria-hidden="true">What are you looking for?</p>

      <div class="chips" role="group" aria-label="Filter costumes by type">
        {chips.map(chip => (
          <button
            class={`${chip.chipClass}${chip.isFirst ? ' chip--active' : ''}`}
            data-chip-id={chip.id}
            data-btn-label={`${chip.btnLabel} →`}
            data-btn-href={chip.href}
            type="button"
            aria-label={`Browse ${chip.label}`}
            aria-pressed={chip.isFirst ? 'true' : 'false'}
          >
            {chip.label}
          </button>
        ))}
      </div>

      <a id="hero-glow-pill" class="glow-pill" href={defaultHref} aria-label={defaultLabel}>
        <span class="glow-pill__icon" aria-hidden="true">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="white">
            <path d="M12 2l2.09 6.26L21 9.27l-5 4.73 1.18 6.54L12 17.27l-5.18 3.27L8 14l-5-4.73 6.91-1.01z"/>
          </svg>
        </span>
        <span class="glow-pill__text" id="hero-btn-text">{defaultLabel}</span>
      </a>

      <ul class="trust-pills" aria-label="Key trust signals">
        <li class="trust-pill">Washed &amp; Ironed</li>
        <li class="trust-pill">Refundable Deposit</li>
        <li class="trust-pill">Reply in 30 mins</li>
        <li class="trust-pill">Maan · Hinjewadi</li>
      </ul>

    </div><!-- /hero__content -->

    <!-- RIGHT: Carousel (desktop only) -->
    <div class="hero__carousel hero__carousel--desktop" aria-label="Featured costume categories">
      <div class="carousel__track">
        {carouselSlides.map((slide, i) => (
          <a
            href={slide.href}
            class={`carousel__slide${i === 0 ? ' carousel__slide--active' : ''}`}
            style="background: #2A1124;"
            aria-label={`Browse ${slide.label}`}
          >
            {slide.image && (
              <img
                src={slide.image}
                alt={slide.label}
                class="carousel__slide-img"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            )}
            <div class="carousel__slide-overlay">
              <span class="stage__tag">
                <svg width="9" height="9" viewBox="0 0 12 12" fill="#D4AF37" aria-hidden="true"><path d="M6 1l1.545 3.09L11 4.618l-2.5 2.427.59 3.42L6 8.817l-3.09 1.648.59-3.42L1 4.618z"/></svg>
                {slide.tag}
              </span>
              <span class="carousel__label">{slide.label}</span>
            </div>
          </a>
        ))}
      </div>
      <div class="carousel__dots">
        {carouselSlides.map((_, i) => (
          <button class={`carousel__dot${i === 0 ? ' carousel__dot--active' : ''}`} data-slide={i} type="button" aria-label={`Go to slide ${i + 1}`}></button>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- Carousel auto-swap JS -->
<script>
  // @ts-nocheck
  const mSlides = Array.from(document.querySelectorAll('.hero__carousel--mobile  .carousel__slide'));
  const dSlides = Array.from(document.querySelectorAll('.hero__carousel--desktop .carousel__slide'));
  const mDots   = Array.from(document.querySelectorAll('.hero__carousel--mobile  .carousel__dot'));
  const dDots   = Array.from(document.querySelectorAll('.hero__carousel--desktop .carousel__dot'));
  const total   = mSlides.length;

  let current = 0;
  let timer   = null;

  function goTo(index) {
    mSlides[current]?.classList.remove('carousel__slide--active');
    dSlides[current]?.classList.remove('carousel__slide--active');
    mDots[current]?.classList.remove('carousel__dot--active');
    dDots[current]?.classList.remove('carousel__dot--active');

    current = ((index % total) + total) % total;

    mSlides[current]?.classList.add('carousel__slide--active');
    dSlides[current]?.classList.add('carousel__slide--active');
    mDots[current]?.classList.add('carousel__dot--active');
    dDots[current]?.classList.add('carousel__dot--active');
  }

  function startAuto() { timer = setInterval(() => goTo(current + 1), 2800); }
  function stopAuto()  { clearInterval(timer); }

  mDots.forEach((dot, i) => {
    dot.addEventListener('click', () => { stopAuto(); goTo(i); startAuto(); });
  });
  dDots.forEach((dot, i) => {
    dot.addEventListener('click', () => { stopAuto(); goTo(i); startAuto(); });
  });

  document.querySelectorAll('.hero__carousel').forEach(el => {
    let touchStart = 0;
    el.addEventListener('touchstart', e => { touchStart = e.changedTouches[0].screenX; }, { passive: true });
    el.addEventListener('touchend', e => {
      const diff = touchStart - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 50) { stopAuto(); goTo(diff > 0 ? current + 1 : current - 1); startAuto(); }
    }, { passive: true });
    el.addEventListener('mouseenter', stopAuto);
    el.addEventListener('mouseleave', startAuto);
  });

  startAuto();
</script>

<!-- Chip switching JS -->
<script>
  // @ts-nocheck
  const chipBtns = document.querySelectorAll('.hero .chip');
  const glowPill = document.getElementById('hero-glow-pill');
  const btnText  = document.getElementById('hero-btn-text');

  chipBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      chipBtns.forEach(b => { b.classList.remove('chip--active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('chip--active');
      btn.setAttribute('aria-pressed', 'true');
      if (glowPill) { glowPill.setAttribute('href', btn.dataset.btnHref); glowPill.setAttribute('aria-label', btn.dataset.btnLabel); }
      if (btnText)  btnText.textContent = btn.dataset.btnLabel;
    });
  });
</script>

<style>
  .hero { background-color: #FAF8F5; padding-top: 2rem; padding-bottom: 2.5rem; }

  .hero__inner { max-width: 1200px; margin-inline: auto; padding-inline: 1.25rem; }

  @media (min-width: 768px) {
    .hero__inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: start;        /* ← FIXED: was 'center' — prevents image squish when chips wrap */
      padding-inline: 3rem;
    }
  }

  /* ── CAROUSEL ── */
  .hero__carousel {
    position: relative;
    border-radius: 1rem;
    border: 0.5px solid rgba(212,175,55,0.1);
    overflow: hidden;
    margin-bottom: 1.25rem;
    aspect-ratio: 3 / 4;
  }

  @media (min-width: 768px) {
    .hero__carousel {
      aspect-ratio: unset;
      height: 520px;             /* ← INCREASED: was 420px — gives image more presence */
      margin-bottom: 0;
      border-radius: 1.25rem;
    }
  }

  .hero__carousel--mobile  { display: block; }
  .hero__carousel--desktop { display: none;  }

  @media (min-width: 768px) {
    .hero__carousel--mobile  { display: none;  }
    .hero__carousel--desktop { display: block; }
  }

  .carousel__track { position: relative; width: 100%; height: 100%; }

  .carousel__slide {
    position: absolute; inset: 0; overflow: hidden;
    opacity: 0; transition: opacity 0.7s ease;
    pointer-events: none; text-decoration: none; display: block;
  }
  .carousel__slide--active { opacity: 1; pointer-events: auto; }

  .carousel__slide-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }

  .carousel__slide-overlay {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    justify-content: space-between; padding: 0.625rem;
    background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, transparent 40%, rgba(0,0,0,0.35) 100%);
  }

  .carousel__label {
    position: absolute; bottom: 0.875rem; left: 50%;
    transform: translateX(-50%);
    background: rgba(42,17,36,0.68); color: #fff;
    font-size: 0.75rem; font-weight: 600;
    padding: 0.3rem 0.875rem; border-radius: 9999px; white-space: nowrap;
  }

  .carousel__dots {
    position: absolute; bottom: 0.625rem; right: 0.75rem;
    display: flex; gap: 0.375rem; z-index: 2;
  }

  .carousel__dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: rgba(255,255,255,0.45);
    border: none; cursor: pointer; padding: 0;
    transition: background 0.2s, transform 0.2s;
  }
  .carousel__dot--active { background: #D4AF37; transform: scale(1.3); }

  .stage__tag {
    position: absolute; top: 0.625rem; left: 0.625rem;
    background: rgba(255,255,255,0.92); border-radius: 0.5rem;
    padding: 0.25rem 0.5rem; font-size: 0.5625rem; font-weight: 700;
    color: #D4AF37; display: flex; align-items: center; gap: 0.3rem;
  }

  /* ── CONTENT ── */
  .hero__content { display: flex; flex-direction: column; gap: 0; }

  .festival-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: rgba(212,175,55,0.08); border: 0.5px solid rgba(212,175,55,0.22);
    border-radius: 9999px; padding: 0.3rem 0.75rem;
    font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: #D4AF37; font-weight: 600; margin-bottom: 1rem;
  }

  .festival-badge__dot {
    width: 6px; height: 6px; border-radius: 50%; background: #D4AF37; flex-shrink: 0;
    animation: badge-pulse 2s ease-in-out infinite;
  }
  @keyframes badge-pulse { 0%,100% { opacity:1; } 50% { opacity:0.35; } }

  .hero__headline {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.75rem, 5vw, 3rem); line-height: 1.17;
    color: #2A1124; margin-bottom: 0.5rem;
  }
  .hero__headline-location { display: block; color: #D4AF37; margin-top: 0.1em; }

  .hero__subline { font-size: 0.8125rem; color: rgba(42,17,36,0.5); line-height: 1.65; margin-bottom: 1.25rem; }

  .chip-label { font-size: 0.625rem; color: rgba(42,17,36,0.38); letter-spacing: 0.02em; margin-bottom: 0.5rem; }

  /* ← FIXED: added flex-wrap: nowrap so chips scroll horizontally instead of wrapping to 2 rows */
  .chips {
    display: flex; gap: 0.4rem;
    overflow-x: auto; padding-bottom: 0.25rem;
    flex-wrap: nowrap;                /* ← KEY FIX */
    scrollbar-width: none; -ms-overflow-style: none;
    margin-bottom: 1.125rem;
  }
  .chips::-webkit-scrollbar { display: none; }

  .chip {
    display: inline-flex; align-items: center; border-radius: 9999px;
    padding: 0.4375rem 0.8rem; font-size: 0.6875rem; font-weight: 500;
    color: #2A1124; white-space: nowrap; flex-shrink: 0; cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    border: 1px solid transparent; min-height: 44px; outline: none;
    -webkit-appearance: none; appearance: none; font-family: inherit;
  }

  .chip--womens  { background: rgba(201,168,76,0.05); border-color: rgba(201,168,76,0.4); }
  .chip--default { background: #fff; border-color: rgba(212,175,55,0.28); }
  .chip--active  { background: #D4AF37 !important; border-color: #D4AF37 !important; color: #fff !important; }

  .glow-pill {
    display: flex; align-items: center; justify-content: center; gap: 0.625rem;
    border-radius: 9999px; padding: 0.9375rem 1.5rem; width: 100%;
    background: #D4AF37;
    box-shadow: 0 6px 22px rgba(212,175,55,0.38), 0 2px 6px rgba(212,175,55,0.2);
    text-decoration: none; margin-bottom: 1rem; min-height: 44px;
    transition: box-shadow 0.2s, transform 0.15s;
  }
  .glow-pill:hover { box-shadow: 0 8px 28px rgba(212,175,55,0.48), 0 3px 8px rgba(212,175,55,0.25); transform: translateY(-1px); }
  .glow-pill:active { transform: scale(0.98); }

  .glow-pill__icon {
    width: 1.625rem; height: 1.625rem; border-radius: 50%;
    background: rgba(255,255,255,0.18); display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .glow-pill__text { font-size: 0.875rem; font-weight: 700; color: #fff; flex: 1; text-align: center; }

  .trust-pills { display: flex; flex-wrap: wrap; gap: 0.375rem; list-style: none; padding: 0; margin: 0; }
  .trust-pill { background: rgba(42,17,36,0.06); border: 0.5px solid rgba(42,17,36,0.09); color: rgba(42,17,36,0.48); font-size: 0.625rem; padding: 0.3125rem 0.625rem; border-radius: 9999px; }
</style>