---
// @ts-nocheck
// WhatsAppBooking.astro — Sprint 2 · Step 7
// ─────────────────────────────────────────────
// Final booking CTA on product detail page
// Disabled until BOTH size + dates are selected
// Generates pre-filled WhatsApp message with full booking details
// Listens for: wearit:size-selected, wearit:dates-selected, wearit:dates-cleared
//
// Props:
//   product  — full product object (name, price, deposit)
//   waNumber — WhatsApp number from constants (waMeNumber)
// ─────────────────────────────────────────────

import { BUSINESS } from '../../lib/constants.js';

const { product, showPrice = false, categoryLabel = "" } = Astro.props;
// showPrice: false = Phase 1 (no price in message), true = show full price breakdown
const waNumber = BUSINESS?.whatsapp?.waMeNumber ?? '919999999999';
---

<div
  class="wa-booking"
  id="wa-booking"
  data-wa-number={waNumber}
  data-product={product.name}
  data-deposit={product.deposit}
  data-show-price={showPrice ? "true" : "false"}
  data-section={categoryLabel}
  data-description={product.description}
  data-has-colors={(product.colors && product.colors.length > 0) ? "true" : "false"}
>

  <!-- Status indicator — only dates needed (size is auto-selected as Free Size) -->
  <div class="wa-booking__status" id="booking-status">
    <div class="status-step" id="step-size" style="display:none;">
      <span class="status-dot status-dot--pending"></span>
      <span class="status-text">Choose a size</span>
    </div>
    <div class="status-step" id="step-dates">
      <span class="status-dot status-dot--pending"></span>
      <span class="status-text">Select your rental dates</span>
    </div>
  </div>

  <!-- WhatsApp CTA button -->
  <a
    href="#"
    class="wa-btn wa-btn--disabled"
    id="wa-cta-btn"
    aria-label="Book via WhatsApp — select size and dates first"
    aria-disabled="true"
  >
    <span class="wa-btn__icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/>
      </svg>
    </span>
    <span class="wa-btn__text" id="wa-btn-text">Select size &amp; dates to book</span>
  </a>

  <!-- Booking summary — visible only when both are selected -->
  <div class="wa-booking__summary" id="booking-summary" style="display:none;">
    <p class="booking-summary__text" id="booking-summary-text"></p>
    <p class="booking-summary__ref" id="booking-ref"></p>
  </div>

</div>

<script>
  // @ts-nocheck

  const wrap        = document.getElementById('wa-booking');
  const ctaBtn      = document.getElementById('wa-cta-btn');
  const btnText     = document.getElementById('wa-btn-text');
  const stepSize    = document.getElementById('step-size');
  const stepDates   = document.getElementById('step-dates');
  const summary     = document.getElementById('booking-summary');
  const summaryText = document.getElementById('booking-summary-text');
  const summaryRef  = document.getElementById('booking-ref');

  const waNumber    = wrap?.dataset.waNumber  ?? '919999999999';
  const showPrice   = wrap?.dataset.showPrice === 'true';
  const sectionName = wrap?.dataset.section      ?? '';
  const productDesc = wrap?.dataset.description  ?? '';
  const hasColors   = wrap?.dataset.hasColors    === 'true';
  const productName = wrap?.dataset.product   ?? 'Costume';
  const deposit     = parseInt(wrap?.dataset.deposit ?? '0', 10);

  // Track state
  let selectedSize      = null;
  let selectedStartDate = null;
  let selectedEndDate   = null;
  let selectedDays      = 0;
  let selectedRental    = 0;
  let selectedColor     = null;

  // ── Generate Booking ID ──
  function makeBookingId() {
    const d = new Date();
    const date = d.toISOString().slice(0,10).replace(/-/g,'');
    const rand = String(Math.floor(Math.random() * 900) + 100);
    return `#WRIT-${date}-${rand}`;
  }

  // ── Format date ──
  function fmtDate(str) {
    return new Date(str).toLocaleDateString('en-IN', {
      day: 'numeric', month: 'long', year: 'numeric',
    });
  }

  // ── Format currency ──
  function inr(n) {
    return '₹' + n.toLocaleString('en-IN');
  }

  // ── Update step indicators ──
  function updateSteps() {
    const sizeDot  = stepSize?.querySelector('.status-dot');
    const sizeText = stepSize?.querySelector('.status-text');
    const dateDot  = stepDates?.querySelector('.status-dot');
    const dateText = stepDates?.querySelector('.status-text');

    if (selectedSize) {
      sizeDot?.classList.replace('status-dot--pending', 'status-dot--done');
      if (sizeText) sizeText.textContent = `Size: ${selectedSize}`;
    } else {
      sizeDot?.classList.replace('status-dot--done', 'status-dot--pending');
      if (sizeText) sizeText.textContent = 'Choose a size';
    }

    if (selectedStartDate && selectedEndDate) {
      dateDot?.classList.replace('status-dot--pending', 'status-dot--done');
      if (dateText) dateText.textContent = `${selectedDays} day${selectedDays > 1 ? 's' : ''} selected`;
    } else {
      dateDot?.classList.replace('status-dot--done', 'status-dot--pending');
      if (dateText) dateText.textContent = 'Select dates';
    }
  }

  // ── Build WhatsApp URL ──
  function buildWaUrl() {
    const bookingId  = makeBookingId();
    const totalAtPickup = selectedRental + deposit;

    const isSingleDay = selectedStartDate === selectedEndDate;
    const dateText = isSingleDay
      ? fmtDate(selectedStartDate)
      : `${fmtDate(selectedStartDate)} to ${fmtDate(selectedEndDate)} (${selectedDays} days)`;

    // Payment summary — only included when showPrice is true
    const paymentLines = showPrice ? [
      ``,
      `💰 Payment Summary`,
      `Rental: ${inr(selectedRental)}`,
      `Refundable Deposit: ${inr(deposit)}`,
      `Total at Pickup: ${inr(totalAtPickup)}`,
    ] : [
      ``,
      `Please share pricing and availability.`,
    ];

    const msg = [
      `Hi wearit! 🙏`,
      ``,
      `📋 Booking Details`,
      `Costume: ${productName}`,
      `Section: ${sectionName}`,
      `Size: ${selectedSize}`,
      ...(selectedColor ? [`Color: ${selectedColor}`] : []),
      `Date: ${dateText}`,
      ``,
      `📝 Description`,
      `${productDesc.slice(0, 120)}${productDesc.length > 120 ? '...' : ''}`,
      ...paymentLines,
      ``,
      `Booking Ref: ${bookingId}`,
      ``,
      `Thank you!`,
    ].join('\n');

    // Show summary
    if (summaryText) {
      summaryText.textContent = `${productName} · ${selectedSize}${selectedColor ? ' · ' + selectedColor : ''} · ${selectedDays} day${selectedDays > 1 ? 's' : ''}`;
    }
    if (summaryRef) {
      summaryRef.textContent = bookingId;
    }
    if (summary) summary.style.display = 'block';

    return `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;
  }

  // ── Enable / Disable button ──
  function updateButton() {
    const isReady = selectedSize && selectedStartDate && selectedEndDate && (!hasColors || selectedColor);

    if (isReady) {
      const url = buildWaUrl();
      ctaBtn?.setAttribute('href', url);
      ctaBtn?.setAttribute('target', '_blank');
      ctaBtn?.setAttribute('rel', 'noopener noreferrer');
      ctaBtn?.setAttribute('aria-disabled', 'false');
      ctaBtn?.setAttribute('aria-label', `Book ${productName} via WhatsApp`);
      ctaBtn?.classList.replace('wa-btn--disabled', 'wa-btn--ready');
      if (btnText) btnText.innerHTML = 'Book via WhatsApp &nbsp;→';
    } else if (selectedSize && !selectedStartDate) {
      ctaBtn?.setAttribute('href', '#');
      ctaBtn?.setAttribute('aria-disabled', 'true');
      ctaBtn?.classList.add('wa-btn--partial');
      ctaBtn?.classList.remove('wa-btn--ready');
      if (!ctaBtn?.classList.contains('wa-btn--disabled')) {
        ctaBtn?.classList.add('wa-btn--disabled');
      }
      if (btnText) btnText.textContent = 'Now select your dates →';
      if (summary) summary.style.display = 'none';
    } else {
      ctaBtn?.setAttribute('href', '#');
      ctaBtn?.setAttribute('aria-disabled', 'true');
      ctaBtn?.classList.replace('wa-btn--ready', 'wa-btn--disabled');
      ctaBtn?.classList.remove('wa-btn--partial');
      if (hasColors && !selectedColor) {
        if (btnText) btnText.textContent = 'Select colour & dates to book';
      } else {
        if (btnText) btnText.textContent = 'Select dates to book';
      }
      if (summary) summary.style.display = 'none';
    }
  }

  // ── Listen for size selection ──
  document.addEventListener('wearit:size-selected', (e) => {
    selectedSize = e.detail.size;
    updateSteps();
    updateButton();
  });

  // ── Listen for color selection ──
  document.addEventListener('wearit:color-selected', (e) => {
    selectedColor = e.detail.color;
    updateSteps();
    updateButton();
  });

  // ── Listen for dates selection ──
  document.addEventListener('wearit:dates-selected', (e) => {
    selectedStartDate = e.detail.startDate;
    selectedEndDate   = e.detail.endDate;
    selectedDays      = e.detail.days;
    selectedRental    = e.detail.totalRental;
    updateSteps();
    updateButton();
  });

  // ── Listen for dates cleared ──
  document.addEventListener('wearit:dates-cleared', () => {
    selectedStartDate = null;
    selectedEndDate   = null;
    selectedDays      = 0;
    selectedRental    = 0;
    updateSteps();
    updateButton();
  });

  // ── Prevent click when disabled ──
  ctaBtn?.addEventListener('click', (e) => {
    if (ctaBtn.getAttribute('aria-disabled') === 'true') {
      e.preventDefault();
    }
  });
</script>

<style>
  /* ═══════════════════════════════════════════
     WRAPPER
  ═══════════════════════════════════════════ */
  .wa-booking {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  /* ── Status steps ── */
  .wa-booking__status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .status-step {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    transition: background 0.2s ease;
  }

  .status-dot--pending { background: rgba(26, 26, 46, 0.2); }
  .status-dot--done    { background: #25D366; }

  .status-text {
    font-size: 0.8125rem;
    color: rgba(26, 26, 46, 0.5);
    transition: color 0.2s ease;
  }

  .status-sep {
    color: rgba(26, 26, 46, 0.2);
    font-size: 0.8125rem;
  }

  /* ═══════════════════════════════════════════
     CTA BUTTON — 3 states
  ═══════════════════════════════════════════ */
  .wa-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    border-radius: 9999px;
    padding: 1rem 1.5rem;
    width: 100%;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    min-height: 56px;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .wa-btn__icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Disabled state — grey, not clickable */
  .wa-btn--disabled {
    background: rgba(26, 26, 46, 0.08);
    color: rgba(26, 26, 46, 0.35);
    cursor: not-allowed;
  }

  .wa-btn--disabled .wa-btn__icon {
    background: rgba(26, 26, 46, 0.1);
  }

  /* Partial state (size selected, no dates) */
  .wa-btn--partial {
    background: rgba(26, 26, 46, 0.08);
    color: #1A1A2E;
    cursor: not-allowed;
  }

  /* Ready state — green glow pill (Style B) */
  .wa-btn--ready {
    background: #25D366;
    color: #fff;
    box-shadow:
      0 6px 22px rgba(37, 211, 102, 0.38),
      0 2px 6px  rgba(37, 211, 102, 0.2);
    cursor: pointer;
  }

  .wa-btn--ready:hover {
    box-shadow:
      0 8px 28px rgba(37, 211, 102, 0.48),
      0 3px 8px  rgba(37, 211, 102, 0.25);
    transform: translateY(-1px);
  }

  .wa-btn--ready:active { transform: scale(0.98); }

  .wa-btn--ready .wa-btn__icon {
    background: rgba(255, 255, 255, 0.2);
  }

  /* ═══════════════════════════════════════════
     BOOKING SUMMARY (shows after ready)
  ═══════════════════════════════════════════ */
  .wa-booking__summary {
    background: rgba(37, 211, 102, 0.06);
    border: 0.5px solid rgba(37, 211, 102, 0.2);
    border-radius: 0.625rem;
    padding: 0.75rem;
  }

  .booking-summary__text {
    font-size: 0.8125rem;
    color: #1A1A2E;
    font-weight: 500;
    margin: 0 0 0.25rem;
  }

  .booking-summary__ref {
    font-size: 0.6875rem;
    color: rgba(26, 26, 46, 0.4);
    font-family: monospace;
    margin: 0;
  }
</style>