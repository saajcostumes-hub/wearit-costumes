---
// @ts-nocheck
// ProductCard.astro — Sprint 2 · Step 2
// ─────────────────────────────────────────────
// Reusable product card used in:
//   - /catalog page (CatalogGrid)
//   - Homepage PopularThisSeason (Step 9 update)
//
// Props:
//   product — full product object from products.js
//   showCategory — show category badge (default true)
//
// Links:
//   "View Details" → /catalog/[slug]
//   "Book via WhatsApp" → enquiry link (no dates — uses generateEnquiryLink)
// ─────────────────────────────────────────────

import { generateEnquiryLink } from '../../lib/whatsapp.js';
import { formatPrice }         from '../../data/products.js';

const { product, showCategory = true } = Astro.props;

// Precompute in frontmatter — no logic in template
const detailUrl  = `/catalog/${product.slug}`;
const enquiryUrl = generateEnquiryLink({ productName: product.name });

const priceDisplay   = formatPrice(product.price);
const depositDisplay = formatPrice(product.deposit);

// Category label + colour precomputed
const categoryMap = {
  womens:      { label: "Women's",      colorClass: 'badge--gold'   },
  nauwari:     { label: 'Nauwari Sarees', colorClass: 'badge--gold' },
  lehenga:     { label: 'Lehenga',      colorClass: 'badge--gold'   },
  maternity:   { label: 'Maternity Gowns', colorClass: 'badge--gold'},
  shaadi:      { label: 'Shaadi Specials', colorClass: 'badge--gold'},
  western:     { label: 'Western & Themed', colorClass: 'badge--gold'},
  traditional: { label: 'Traditional',  colorClass: 'badge--orange' },
  kids:        { label: 'Kids',          colorClass: 'badge--green'  },
};
const categoryInfo = categoryMap[product.category] ?? { label: product.category, colorClass: 'badge--orange' };

// Size pill colour
const sizePillClass = product.sizes[0] === 'Free Size'
  ? 'size-pill--free'
  : product.sizeType === 'kids'
    ? 'size-pill--gold'
    : 'size-pill--orange';
---

<article class="prod-card" aria-label={product.name}>

  <!-- Image area -->
  <a href={detailUrl} class="prod-card__img-wrap" aria-label={`View details for ${product.name}`} tabindex="-1">
    {product.image ? (
      <img
        src={product.image}
        alt={product.alt}
        class="prod-card__img"
        loading="lazy"
        width="400"
        height="300"
      />
    ) : (
      <div class="prod-card__placeholder" aria-hidden="true">
        <svg class="prod-card__camera" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
          <circle cx="12" cy="13" r="4"/>
        </svg>
      </div>
    )}

    <!-- Product badge — "Only in wearit" or "Most Booked" -->
    {product.badge && (
      <span class={`prod-card__badge prod-card__badge--${product.badgeType}`}>
        {product.badge}
      </span>
    )}

    <!-- Category badge -->
    {showCategory && (
      <span class={`prod-card__cat-badge ${categoryInfo.colorClass}`}>
        {categoryInfo.label}
      </span>
    )}
  </a>

  <!-- Card body -->
  <div class="prod-card__body">

    <!-- Name -->
    <h3 class="prod-card__name">{product.name}</h3>

    <!-- Pricing row — HIDDEN Phase 1. Uncomment to show pricing.
    <div class="prod-card__pricing">
      <span class="prod-card__price">
        {priceDisplay}
        <span class="prod-card__per">/event</span>
      </span>
      <span class="prod-card__deposit">Deposit: {depositDisplay}</span>
    </div>
    -->

    <!-- Sizes -->
    {product.sizes.length > 0 && (
      <div class="prod-card__sizes" aria-label={`Available sizes for ${product.name}`}>
        {product.sizes.map(size => (
          <span class={`size-pill ${sizePillClass}`}>{size}</span>
        ))}
      </div>
    )}

    <!-- Actions -->
    <div class="prod-card__actions">
      <a href={detailUrl} class="prod-card__btn-detail">
        View Details
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>

      <a
        href={enquiryUrl}
        class="prod-card__btn-wa"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Enquire about ${product.name} via WhatsApp`}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/>
        </svg>
        WhatsApp
      </a>
    </div>

  </div>
</article>

<style>
  /* ═══════════════════════════════════════════
     CARD SHELL
  ═══════════════════════════════════════════ */
  .prod-card {
    background: #fff;
    border: 0.5px solid rgba(42, 17, 36, 0.08);
    border-radius: 0.875rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 1px 4px rgba(42, 17, 36, 0.05);
    transition: box-shadow 0.2s ease, transform 0.15s ease;
    height: 100%;
  }

  .prod-card:hover {
    box-shadow: 0 6px 20px rgba(42, 17, 36, 0.1);
    transform: translateY(-2px);
  }

  /* ═══════════════════════════════════════════
     IMAGE AREA
  ═══════════════════════════════════════════ */
  .prod-card__img-wrap {
    text-decoration: none;
    display: block;
    position: relative;
    flex-shrink: 0;
  }

  .prod-card__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .prod-card__placeholder {
    background: linear-gradient(145deg, #F5E6D0, #EDD5B8);
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 0.5px solid rgba(42, 17, 36, 0.06);
  }

  .prod-card__camera {
    width: 2rem;
    height: 2rem;
    color: rgba(42, 17, 36, 0.18);
  }

  /* ── Product badge (Only in wearit / Most Booked) ── */
  .prod-card__badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    font-size: 0.5625rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    line-height: 1;
  }

  .prod-card__badge--exclusive {
    background: rgba(212, 175, 55, 0.12);
    color: #D4AF37;
  }

  .prod-card__badge--price {
    background: rgba(201, 168, 76, 0.12);
    color: #D4AF37;
  }

  /* ── Category badge ── */
  .prod-card__cat-badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font-size: 0.5625rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    line-height: 1;
  }

  .badge--gold   { background: rgba(201,168,76,0.12); color: #D4AF37; }
  .badge--orange { background: rgba(212,175,55,0.1);   color: #D4AF37; }
  .badge--green  { background: rgba(37,211,102,0.1);  color: #1D9E75; }

  /* ═══════════════════════════════════════════
     CARD BODY
  ═══════════════════════════════════════════ */
  .prod-card__body {
    padding: 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  /* ── Name ── */
  .prod-card__name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #2A1124;
    line-height: 1.3;
    margin: 0;
  }

  /* ── Pricing ── */
  .prod-card__pricing {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .prod-card__price {
    font-size: 1.125rem;
    font-weight: 700;
    color: #D4AF37;
    line-height: 1.2;
  }

  .prod-card__per {
    font-size: 0.6875rem;
    font-weight: 400;
    color: rgba(42, 17, 36, 0.35);
  }

  .prod-card__deposit {
    font-size: 0.6875rem;
    color: rgba(42, 17, 36, 0.4);
  }

  /* ── Size pills ── */
  .prod-card__sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .size-pill {
    font-size: 0.625rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 0.3rem;
    line-height: 1.4;
  }

  .size-pill--orange { background: rgba(212,175,55,0.1);   color: #D4AF37; }
  .size-pill--free   { background: rgba(34,197,94,0.1);    color: #15803d; }
  .size-pill--gold   { background: rgba(201,168,76,0.12); color: #D4AF37; }

  /* ═══════════════════════════════════════════
     ACTION BUTTONS
  ═══════════════════════════════════════════ */
  .prod-card__actions {
    display: flex;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  /* View Details — dark charcoal, flex-1 */
  .prod-card__btn-detail {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    flex: 1;
    background: #2A1124;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
    min-height: 44px;
    transition: background 0.15s ease;
  }

  .prod-card__btn-detail:hover { background: #3D1A36; }

  /* WhatsApp — green outline, icon only on mobile */
  .prod-card__btn-wa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    border: 2px solid #25D366;
    color: #25D366;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.625rem 0.875rem;
    border-radius: 0.5rem;
    text-decoration: none;
    min-height: 44px;
    white-space: nowrap;
    transition: background 0.15s ease;
  }

  .prod-card__btn-wa:hover { background: rgba(37, 211, 102, 0.08); }
</style>